{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "noUncheckedIndexedAccess": true,
    "outDir": "dist/js",
    "rootDir": "src",
    "removeComments": true,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
