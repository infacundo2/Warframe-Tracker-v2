@page "/"
@namespace WarframeInventory.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using WarframeInventory

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Warframe Tracker</title>
    <base href="~/" />

    <!-- MudBlazor -->
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="preconnect" href="https://cdn.warframestat.us" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.warframestat.us" />

    <!-- Custom CSS (si agregas estilos propios) -->
    <link rel="stylesheet" href="css/site.css" asp-append-version="true" />
</head>
<body>
    <app>
        @(await Html.RenderComponentAsync<App>(RenderMode.ServerPrerendered))
    </app>

    <script src="js/i18n.js" asp-append-version="true"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.server.js"></script>
    <script src="js/site.js" asp-append-version="true"></script>
    <script src="js/native-bridge.js" asp-append-version="true"></script>
</body>
</html>
