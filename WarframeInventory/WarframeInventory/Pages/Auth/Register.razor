@page "/auth/register"

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudPaper Class="p-6 orokin-panel">
        <MudText Typo="Typo.overline" Color="Color.Secondary">NUEVO PERFIL DE OPERADOR</MudText>
        <MudText Typo="Typo.h4" Class="mt-1">Crear cuenta</MudText>
        <MudText Typo="Typo.body2" Class="mt-2 mb-4">
            Registra tus credenciales para guardar el progreso de tu inventario.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
                @Error
            </MudAlert>
        }

        <form method="post" action="/auth/register-mvc">
            <MudTextField @bind-Value="Username"
                          Name="username"
                          Label="Nombre de usuario"
                          HelperText="De 3 a 24 caracteres: letras sin tilde, números, punto, guion o guion bajo."
                          Variant="Variant.Outlined"
                          Immediate="true"
                          MaxLength="24"
                          Class="mt-3"
                          Required="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.PersonOutline" />

            <MudTextField @bind-Value="Email"
                          Name="email"
                          Label="Correo electrónico"
                          HelperText="Lo utilizaremos como identificador único de tu cuenta."
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Immediate="true"
                          Class="mt-3"
                          Required="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.AlternateEmail" />

            <MudTextField @bind-Value="Password"
                          Name="password"
                          Label="Contraseña"
                          HelperText="Mínimo 10 caracteres, una letra minúscula y un número."
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Immediate="true"
                          Class="mt-3"
                          Required="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Lock" />

            <MudTextField @bind-Value="ConfirmPassword"
                          Name="confirmPassword"
                          Label="Confirmar contraseña"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Immediate="true"
                          Class="mt-3"
                          Required="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Lock" />

            <MudButton Type="Submit"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="mt-5"
                       ButtonType="ButtonType.Submit">
                Crear cuenta
            </MudButton>
        </form>

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
            ¿Ya tienes una cuenta?
            <MudLink Href="/auth/login">Iniciar sesión</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "usuario")]
    public string? SavedUsername { get; set; }

    [SupplyParameterFromQuery(Name = "correo")]
    public string? SavedEmail { get; set; }

    private string Username = "";
    private string Email = "";
    private string Password = "";
    private string ConfirmPassword = "";

    protected override void OnParametersSet()
    {
        Username = SavedUsername ?? "";
        Email = SavedEmail ?? "";
        Password = "";
        ConfirmPassword = "";
    }
}
