@page "/auth/register"
@using Microsoft.AspNetCore.Identity
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudPaper Class="p-6">
        <MudText Typo="Typo.h5" Align="Align.Center">Crear cuenta</MudText>

        <!-- 
            ✅ Formulario MVC clásico (no Blazor).
            ✅ Usa la misma lógica que login-mvc.
        -->
        <form method="post" action="/auth/register-mvc" onsubmit="console.log('➡️ Registro enviado');">
            <MudTextField @bind-Value="Username"
                          Label="Usuario"
                          Variant="Variant.Outlined"
                          Class="mt-3"
                          Required="true" />

            <MudTextField @bind-Value="Email"
                          Label="Correo electrónico"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Class="mt-3"
                          Required="true" />

            <MudTextField @bind-Value="Password"
                          Label="Contraseña"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Class="mt-3"
                          Required="true" />

            <MudTextField @bind-Value="ConfirmPassword"
                          Label="Confirmar contraseña"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Class="mt-3"
                          Required="true" />

            <!-- Campos HTML reales que viajan en el POST -->
            <input type="hidden" name="username" value="@Username" />
            <input type="hidden" name="email" value="@Email" />
            <input type="hidden" name="password" value="@Password" />

            <MudButton Type="Submit"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Class="mt-4"
                       ButtonType="ButtonType.Submit">
                Registrarse
            </MudButton>
        </form>

        @if (Nav.Uri.Contains("error="))
        {
            <MudText Color="Color.Error" Class="mt-3" Align="Align.Center">
                @Uri.UnescapeDataString(Nav.Uri.Split("error=")[1])
            </MudText>
        }

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
            ¿Ya tienes cuenta?
            <MudLink Href="/auth/login">Iniciar sesión</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private string Username = string.Empty;
    private string Email = string.Empty;
    private string Password = string.Empty;
    private string ConfirmPassword = string.Empty;
}
