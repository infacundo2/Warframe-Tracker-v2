@page "/auth/login"
@using Microsoft.AspNetCore.Identity
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudPaper Class="p-6">
        <MudText Typo="Typo.h5" Align="Align.Center">Iniciar Sesión</MudText>

        <!-- 
            ✅ Este formulario se envía directamente al backend (MVC), no por Blazor.
            ✅ forceLoad: true en el botón de acceso desde el Index garantiza recarga completa.
        -->
        <form method="post" action="/auth/login-mvc" onsubmit="console.log('➡️ Form enviado');">
            <MudTextField @bind-Value="Username"
                          Label="Usuario"
                          Variant="Variant.Outlined"
                          Class="mt-3"
                          Required="true" />

            <MudTextField @bind-Value="Password"
                          Label="Contraseña"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Class="mt-3"
                          Required="true" />

            <MudCheckBox @bind-Checked="RememberMe"
                         Label="Recordarme"
                         Class="mt-2" />

            <!-- Campos HTML reales que viajan en el POST -->
            <input type="hidden" name="username" value="@Username" />
            <input type="hidden" name="password" value="@Password" />
            <input type="hidden" name="rememberMe" value="@RememberMe" />

            <MudButton Type="Submit"
                    Color="Color.Primary"
                    Variant="Variant.Filled"
                    Class="mt-4"
                    ButtonType="ButtonType.Submit">
                Entrar
            </MudButton>

        </form>

        @if (Nav.Uri.Contains("error="))
        {
            <MudText Color="Color.Error" Class="mt-3" Align="Align.Center">
                @Uri.UnescapeDataString(Nav.Uri.Split("error=")[1])
            </MudText>
        }

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
            ¿No tienes cuenta?
            <MudLink Href="/auth/register">Registrarse</MudLink>
        </MudText>
    </MudPaper>

    
</MudContainer>

@code {
    private string Username = string.Empty;
    private string Password = string.Empty;
    private bool RememberMe = false;
}
