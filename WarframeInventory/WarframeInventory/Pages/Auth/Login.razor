@page "/auth/login"

@inject NavigationManager Nav
@inject HttpClient Http
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudPaper Class="p-6">
        <MudText Typo="Typo.h5">Iniciar Sesión</MudText>

        <MudTextField @bind-Value="Username" Label="Usuario" Variant="Variant.Outlined" Class="mt-3" />
        <MudTextField @bind-Value="Password" Label="Contraseña" Variant="Variant.Outlined" InputType="InputType.Password" Class="mt-3" />
        <MudCheckBox @bind-Checked="RememberMe" Label="Recordarme" Class="mt-2" />

        <MudButton OnClick="LoginAsync" Color="Color.Primary" Variant="Variant.Filled" Class="mt-4">Entrar</MudButton>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <MudText Color="Color.Error" Class="mt-2">@ErrorMessage</MudText>
        }
    </MudPaper>
</MudContainer>

@code {
    private string Username = "";
    private string Password = "";
    private bool RememberMe = false;
    private string? ErrorMessage;

    private async Task LoginAsync()
    {
        ErrorMessage = null;
        try
        {
            var dto = new { Username, Password, RememberMe };
            var response = await Http.PostAsJsonAsync(Nav.BaseUri + "api/auth/login", dto);


            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/", forceLoad: true);
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                ErrorMessage = string.IsNullOrWhiteSpace(msg) ? "Error al iniciar sesión." : msg;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error: {ex.Message}";
        }
    }
}
