@page "/auth/login"
@using Microsoft.AspNetCore.Identity
@inject NavigationManager Nav

<main class="stark-login">
    <section class="stark-login__visual" aria-hidden="true">
        <div class="arc-reactor">
            <span class="arc-reactor__core"></span>
            <span class="arc-reactor__ring arc-reactor__ring--one"></span>
            <span class="arc-reactor__ring arc-reactor__ring--two"></span>
            <span class="arc-reactor__ring arc-reactor__ring--three"></span>
        </div>
        <div class="hud-readout hud-readout--top">SISTEMA // TENNO OS</div>
        <div class="hud-readout hud-readout--bottom">ENLACE CIFRADO · ESTABLE</div>
        <div class="hud-scanline"></div>
    </section>

    <MudPaper Class="stark-login__panel" Square="true">
        <div class="stark-login__status">
            <span class="status-pulse"></span>
            AUTORIZACIÓN DE OPERADOR
            <span>SYS.01</span>
        </div>

        <div class="stark-login__heading">
            <div class="eyebrow">ACCESO SEGURO // REGISTRO WARFRAME</div>
            <MudText Typo="Typo.h3">Identifícate</MudText>
            <MudText Typo="Typo.body1">Restablece el enlace con tu inventario personal.</MudText>
        </div>

        <form class="stark-login__form" method="post" action="/auth/login-mvc"
              onsubmit="return syncLoginFields();">
            <MudTextField @bind-Value="Username"
                          Label="Identificador de operador"
                          Variant="Variant.Outlined"
                          Required="true"
                          Name="username"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.PersonOutline" />

            <MudTextField @bind-Value="Password"
                          Label="Código de acceso"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          Name="password"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Lock" />

            <div class="stark-login__options">
                <MudCheckBox @bind-Checked="RememberMe"
                             Label="Mantener enlace"
                             Name="rememberMe"
                             Color="Color.Primary" />
                <span>CANAL TLS ACTIVO</span>
            </div>

            <MudButton Type="Submit"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="stark-login__submit"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       ButtonType="ButtonType.Submit">
                Iniciar enlace
            </MudButton>
        </form>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="stark-login__error" role="alert">
                @Error
            </div>
        }

        <div class="stark-login__footer">
            <span>¿OPERADOR NUEVO?</span>
            <MudLink Href="/auth/register">Crear credenciales</MudLink>
        </div>
    </MudPaper>

   <script>
        function syncLoginFields() {
            const form = document.querySelector("form[action='/auth/login-mvc']");
            if (!form) return true;
            const inputs = form.querySelectorAll("input");
            for (const input of inputs) {
                // fuerza que todos los inputs se sincronicen antes de enviar
                input.dispatchEvent(new Event("change"));
                input.dispatchEvent(new Event("input"));
            }
            return true; // permite enviar el form
        }
    </script>
</main>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "usuario")]
    public string? SavedUsername { get; set; }

    private string Username = string.Empty;
    private string Password = string.Empty;
    private bool RememberMe = false;

    protected override void OnParametersSet()
    {
        Username = SavedUsername ?? "";
        Password = "";
    }
}
