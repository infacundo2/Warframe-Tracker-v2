@page "/relics"
@using Microsoft.EntityFrameworkCore
@inject WarframeInventory.Data.ApplicationDbContext Db
@inject AuthenticationStateProvider AuthState
@using WarframeInventory.Models
@using MudBlazor
@using System.Security.Claims

<MudContainer  MaxWidth="MaxWidth.False"
              Class="px-6 py-4 min-h-[80vh] flex flex-col justify-start">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h4" Color="Color.Primary">Reliquias</MudText>
        <AuthorizeView>
            <Authorized>
                <MudButton Href="/desktop-sync"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Sensors">
                    Actualizar inventario automáticamente
                </MudButton>
            </Authorized>
        </AuthorizeView>

        <MudTextField @bind-Value="searchTerm"
                      Placeholder="Buscar reliquia..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="catalog-toolbar"
                      Immediate="true"
                      DebounceInterval="350"
                      OnDebounceIntervalElapsed="@(() => LoadPageAsync(1))" />

        <MudSelect T="string"
                   Label="Estado de la reliquia"
                   Value="@availabilityFilter"
                   ValueChanged="OnAvailabilityChanged"
                   Variant="Variant.Outlined"
                   Class="catalog-filter">
            <MudSelectItem T="string" Value="@("all")">Todas</MudSelectItem>
            <MudSelectItem T="string" Value="@("available")">Solo disponibles</MudSelectItem>
            <MudSelectItem T="string" Value="@("vaulted")">Solo vaulted</MudSelectItem>
        </MudSelect>

        @if (loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mx-auto my-8" />
        }
        else if (pagedRelics.Count == 0)
        {
            <MudText Typo="Typo.body1" Align="Align.Center">No se encontraron reliquias.</MudText>
        }
        else
        {
            <MudGrid GutterSize="3">
                @foreach (var r in pagedRelics)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Class="mb-4 p-2">
                            <img src="@GetImageUrl(r.ImageName)" loading="lazy" decoding="async"
                                 width="360" height="210" class="catalog-image" alt="@r.Name" />

                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1" Color="Color.Primary">@r.Name</MudText>
                                <MudText Typo="Typo.caption">@r.Category</MudText>
                                <MudText Typo="Typo.caption">@(r.Vaulted ? "En bóveda" : "Disponible")</MudText>

                                <MudNumericField T="int"
                                                 Value="@r.OwnedCount"
                                                 ValueChanged="@(async (int v) => await UpdateOwnedAsync(r, v))"
                                                 Label="Cantidad"
                                                 Min="0" Max="99"
                                                 Immediate="true"
                                                 Disabled="@string.IsNullOrEmpty(userId)"
                                                 Class="mt-2 w-28" />
                            </MudCardContent>

                            <MudCardActions>
                                <MudButton Variant="Variant.Text" Color="Color.Primary"
                                           Href="@($"/relics/{Uri.EscapeDataString(r.UniqueName)}")">
                                    Ver detalle
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>

            <div class="d-flex justify-center mt-6">
                <MudPagination Selected="@currentPage"
                               Count="@totalPages"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary"
                               Size="Size.Medium" />
            </div>
        }
    </MudStack>
</MudContainer>

@code {
    private List<RelicViewModel> pagedRelics = new();
    private bool loading = true;
    private string? searchTerm = "";
    private string availabilityFilter = "all";
    private int currentPage = 1;
    private int totalPages = 1;
    private const int pageSize = 10;
    private string userId = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        await LoadPageAsync(1);
    }

    private async Task LoadPageAsync(int page)
    {
        loading = true;
        StateHasChanged();

        // Las cuatro variantes siguen cargadas para el inventario I/E/P/R.
        // El catálogo muestra solo la representación Intacta (Bronze).
        var query = Db.Relics
            .Where(r => r.UniqueName.EndsWith("Bronze"))
            .AsQueryable();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            string term = searchTerm.ToLower();
            query = query.Where(r => EF.Functions.Like(r.Name, $"%{term}%"));
        }

        query = availabilityFilter switch
        {
            "available" => query.Where(r => !r.Vaulted),
            "vaulted" => query.Where(r => r.Vaulted),
            _ => query
        };

        int totalCount = await query.CountAsync();
        totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
        currentPage = Math.Clamp(page, 1, totalPages);

        var relics = await query
            .OrderBy(r => r.Name)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();

        // 🔹 Cargar inventario del usuario
        var pageKeys = relics.Select(x => x.UniqueName).ToList();
        var userRelics = await Db.UserRelics.AsNoTracking()
            .Where(u => u.UserId == userId && pageKeys.Contains(u.RelicUnique))
            .ToListAsync();

        pagedRelics = relics.Select(r => new RelicViewModel
        {
            Id = r.Id,
            UniqueName = r.UniqueName,
            Name = r.Name,
            Category = r.Category,
            Vaulted = r.Vaulted,
            ImageName = r.ImageName,
            OwnedCount = userRelics.FirstOrDefault(u => u.RelicUnique == r.UniqueName)?.Quantity ?? 0
        }).ToList();

        loading = false;
        StateHasChanged();
    }

    private async Task UpdateOwnedAsync(RelicViewModel relic, int count)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(userId))
                return;

            var existing = await Db.UserRelics.FirstOrDefaultAsync(
                x => x.UserId == userId && x.RelicUnique == relic.UniqueName);

            if (existing == null)
            {
                existing = new UserRelic
                {
                    UserId = userId,
                    RelicUnique = relic.UniqueName,
                    Quantity = count
                };
                Db.UserRelics.Add(existing);
            }
            else
            {
                existing.Quantity = count;
            }

            await Db.SaveChangesAsync();
            relic.OwnedCount = count;
            Console.WriteLine($"✅ Reliquia {relic.Name} actualizada → {count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error al actualizar reliquia: {ex.Message}");
        }
    }

    private async Task OnPageChanged(int newPage)
    {
        await LoadPageAsync(newPage);
    }

    private async Task OnAvailabilityChanged(string value)
    {
        availabilityFilter = value;
        await LoadPageAsync(1);
    }

    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "/images/item-placeholder.svg"
            : $"https://cdn.warframestat.us/img/{imageName}";

    private class RelicViewModel
    {
        public int Id { get; set; }
        public string UniqueName { get; set; } = "";
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public string? ImageName { get; set; }
        public bool Vaulted { get; set; }
        public int OwnedCount { get; set; }
    }
}
