@page "/relics"
@using Microsoft.EntityFrameworkCore
@inject WarframeInventory.Data.ApplicationDbContext Db
@using WarframeInventory.Models

<MudText Typo="Typo.h4" Class="mb-4">Reliquias</MudText>

<MudPaper Class="p-4">
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (relics == null || relics.Count == 0)
    {
        <MudText>No se encontraron reliquias.</MudText>
    }
    else
    {
        <MudGrid>
            @foreach (var r in relics)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Class="mb-4">
                        <img src="@GetImageUrl(r.ImageName)" alt="@r.Name"
                             style="width:100%;height:200px;object-fit:contain;background-color:#111;border-radius:8px;" />
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary">@r.Name</MudText>
                            <MudText Typo="Typo.caption">@r.Category</MudText>
                            <MudText Typo="Typo.caption">@(r.Vaulted ? "Vaulted" : "Disponible")</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                       Href="@($"/relics/{Uri.EscapeDataString(r.UniqueName)}")">
                                Ver detalle
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>

@code {
    private List<Relic>? relics;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            relics = await Db.Relics
                .OrderBy(r => r.Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando reliquias: {ex.Message}");
            relics = new();
        }

        loading = false;
    }

    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "_content/MudBlazor/images/placeholder.png"
            : $"https://cdn.warframestat.us/img/{imageName}";
}
