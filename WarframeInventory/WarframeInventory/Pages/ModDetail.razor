@page "/mods/{uniqueName}"
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@inject WarframeInventory.Data.ApplicationDbContext Db
@inject AuthenticationStateProvider AuthState
@inject UserGoalService GoalService
@using WarframeInventory.Models
@using MudBlazor
@using System.Security.Claims

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (mod == null)
    {
        <MudText Typo="Typo.h6" Color="Color.Error">
            No se encontró el mod solicitado.
        </MudText>
    }
    else
    {
        <MudPaper Class="p-6">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <img src="@GetImageUrl(mod.ImageName)"
                         alt="@mod.Name"
                         style="width:100%;border-radius:8px;" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h4" Color="Color.Primary">@mod.Name</MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="@(goalSelected ? Color.Secondary : Color.Primary)"
                               StartIcon="@Icons.Material.Filled.TrackChanges"
                               Disabled="@string.IsNullOrWhiteSpace(userId)"
                               OnClick="ToggleGoalAsync"
                               Class="mt-2">
                        @(goalSelected ? "Quitar de objetivos" : "Añadir a objetivos")
                    </MudButton>
                    <MudText Typo="Typo.body1" Class="mt-2 mb-3">@mod.Description</MudText>

                    <MudList Dense="true">
                        <MudListItem><b>Rareza:</b> @WarframeSpanishText.Rarity(mod.Rarity)</MudListItem>
                        <MudListItem><b>Polaridad:</b> @mod.Polarity</MudListItem>
                        <MudListItem><b>Compatibilidad:</b> @mod.CompatName</MudListItem>
                        <MudListItem><b>Límite de fusión:</b> @mod.FusionLimit</MudListItem>
                    </MudList>

                    <MudDivider Class="my-3" />

                    <MudNumericField T="int"
                                    Value="@ownedCount"
                                    ValueChanged="@(async (int v) => await UpdateOwnedAsync(v))"
                                    Label="Cantidad que posees"
                                    Min="0" Max="99"
                                    Immediate="true"
                                    Class="w-40" />

                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Calculadora de fusión</MudText>
            <MudPaper Class="fusion-calculator">
                <MudSlider T="int" @bind-Value="selectedRank" Min="0"
                           Max="@(mod.FusionLimit ?? 0)" Step="1">
                    Rango objetivo: @selectedRank / @(mod.FusionLimit ?? 0)
                </MudSlider>
                <div>
                    <span>ENDO ACUMULADO<strong>@FusionEndo.ToString("N0")</strong></span>
                    <span>CRÉDITOS ESTIMADOS<strong>@FusionCredits.ToString("N0")</strong></span>
                    <span>DRENAJE RESULTANTE<strong>@ResultingDrain</strong></span>
                </div>
                <MudText Typo="Typo.caption">
                    Endo calculado por rareza y rango. Los créditos son una estimación;
                    confirma el importe final en la estación de mods.
                </MudText>
            </MudPaper>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Niveles de mejora</MudText>
            @if (levelStats == null || levelStats.Count == 0)
            {
                <MudText Typo="Typo.caption">Sin datos de nivel.</MudText>
            }
            else
            {
                <MudTable Items="@levelStats" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Nivel</MudTh>
                        <MudTh>Bonificación</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Nivel">@context.Level</MudTd>
                        <MudTd DataLabel="Bonificación">@context.Stat</MudTd>
                    </RowTemplate>
                </MudTable>
            }

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Cómo conseguirlo</MudText>
            @if (drops == null || drops.Count == 0)
            {
                <MudText Typo="Typo.caption">
                    La fuente de datos no registra todavía un método de obtención para este mod.
                </MudText>
            }
            else
            {
                <MudList Dense="true">
                    @foreach (var d in drops)
                    {
                        <MudListItem>
                            <div>
                                <b>@WarframeSpanishText.Location(d.Location ?? "Desconocido")</b>
                                @if (!string.IsNullOrWhiteSpace(d.Method))
                                {
                                    <span class="acquisition-method"> · @WarframeSpanishText.Type(d.Method)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(d.Rarity))
                                {
                                    <span> — @WarframeSpanishText.Rarity(d.Rarity)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(d.ChanceFormatted))
                                {
                                    <span style="color:gray;"> (@d.ChanceFormatted)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(d.Url))
                                {
                                    <div>
                                        <MudLink Href="@d.Url" Target="_blank" Rel="noopener noreferrer">
                                            Abrir guía
                                        </MudLink>
                                    </div>
                                }
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public string? uniqueName { get; set; }

    private Mod? mod;
    private bool loading = true;
    private List<LevelStat> levelStats = new();
    private List<ModDrop> drops = new();
    private int ownedCount = 0;
    private string userId = "";
    private bool goalSelected;
    private int selectedRank;
    private int FusionEndo
    {
        get
        {
            if (mod is null || selectedRank <= 0) return 0;
            var baseCost = (mod.Rarity ?? "").ToLowerInvariant() switch
            {
                "legendary" or "legendaria" => 40,
                "rare" or "rara" => 30,
                "uncommon" or "poco común" => 20,
                _ => 10
            };
            return baseCost * ((1 << Math.Min(selectedRank, 20)) - 1);
        }
    }
    private int FusionCredits => (int)Math.Ceiling(FusionEndo * 48.3d);
    private int ResultingDrain => (mod?.BaseDrain ?? 0) + selectedRank;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(uniqueName))
                return;

            var decodedName = Uri.UnescapeDataString(uniqueName);

            var authState = await AuthState.GetAuthenticationStateAsync();
            userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

            mod = await Db.Mods
                .AsNoTracking()
                .FirstOrDefaultAsync(m => m.UniqueName == decodedName);

            if (mod == null)
            {
                Console.WriteLine($"❌ No se encontró el mod {decodedName}");
                return;
            }
            selectedRank = mod.FusionLimit ?? 0;

            if (!string.IsNullOrWhiteSpace(userId))
                goalSelected = await GoalService.IsGoalAsync(
                    userId, "mod", mod.UniqueName);

            Console.WriteLine($"✅ Cargando mod: {mod.Name}");

            // 🔹 Deserializar niveles
            if (!string.IsNullOrWhiteSpace(mod.LevelStatsJson))
            {
                var parsed = JsonSerializer.Deserialize<List<Dictionary<string, List<string>>>>(mod.LevelStatsJson);
                if (parsed != null)
                {
                    int level = 0;
                    foreach (var item in parsed)
                    {
                        if (item.TryGetValue("stats", out var stats))
                        {
                            foreach (var stat in stats)
                                levelStats.Add(new LevelStat { Level = level, Stat = stat });
                        }
                        level++;
                    }
                }
                Console.WriteLine($"📊 Niveles cargados: {levelStats.Count}");
            }

            // 🔹 Deserializar drops
            if (!string.IsNullOrWhiteSpace(mod.DropsJson))
            {
                try
                {
                    if (mod.DropsJson.TrimStart().StartsWith("\""))
                        mod.DropsJson = JsonSerializer.Deserialize<string>(mod.DropsJson);

                    Console.WriteLine($"📦 Raw DropsJson = {mod.DropsJson}");
                    drops = JsonSerializer.Deserialize<List<ModDrop>>(mod.DropsJson ?? "[]") ?? new();
                    Console.WriteLine($"✅ Se cargaron {drops.Count} drops para este mod");

                    foreach (var d in drops)
                        Console.WriteLine($"   - {d.Location} ({d.Rarity}) {d.Chance:P0}");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"❌ Error deserializando DropsJson: {ex.Message}");
                }
            }

            // 🔹 Cargar cantidad del usuario
            var owned = await Db.UserMods.FirstOrDefaultAsync(u => u.UserId == userId && u.ModUnique == mod.UniqueName);
            ownedCount = owned is null ? 0 : Math.Max(owned.Quantity, owned.Owned ? 1 : 0);
            Console.WriteLine($"👤 Usuario {userId} tiene {ownedCount} de este mod");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error cargando detalle de mod: {ex.Message}");
        }

        loading = false;
    }

    private async Task UpdateOwnedAsync(int count)
    {
        try
        {
            if (mod == null || string.IsNullOrWhiteSpace(userId))
                return;

            var existing = await Db.UserMods.FirstOrDefaultAsync(u => u.UserId == userId && u.ModUnique == mod.UniqueName);

            if (existing == null)
            {
                existing = new UserMod
                {
                    UserId = userId,
                    ModUnique = mod.UniqueName,
                    Owned = count > 0,
                    Quantity = count
                };
                Db.UserMods.Add(existing);
            }
            else
            {
                existing.Owned = count > 0;
                existing.Quantity = count;
            }

            await Db.SaveChangesAsync();
            ownedCount = count;

            Console.WriteLine($"✅ Mod {mod.Name} actualizado → Cantidad={count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error al actualizar mod: {ex.Message}");
        }
    }

    private async Task ToggleGoalAsync()
    {
        if (mod is null || string.IsNullOrWhiteSpace(userId))
            return;

        goalSelected = await GoalService.ToggleAsync(
            userId, "mod", mod.UniqueName, mod.Name);
    }


    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "_content/MudBlazor/images/placeholder.png"
            : $"https://cdn.warframestat.us/img/{imageName}";

    private class LevelStat
    {
        public int Level { get; set; }
        public string Stat { get; set; } = "";
    }
}
