@page "/weapons"

@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject WarframeInventory.Data.ApplicationDbContext Db
@inject AuthenticationStateProvider AuthState
@using WarframeInventory.Models
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.False" Class="px-6 py-4">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h4" Color="Color.Primary">Armas</MudText>

        <!-- 🔍 Búsqueda -->
        <MudTextField @bind-Value="searchTerm"
                      Placeholder="Buscar arma..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="catalog-toolbar"
                      Immediate="true"
                      DebounceInterval="350"
                      OnDebounceIntervalElapsed="RefreshAsync" />

        @if (loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mx-auto my-8" />
        }
        else if (pagedWeapons.Count == 0)
        {
            <MudText Typo="Typo.body1" Align="Align.Center">No se encontraron armas.</MudText>
        }
        else
        {
            <MudGrid GutterSize="3">
                @foreach (var w in pagedWeapons)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Class="mb-4">
                            <img src="@GetImageUrl(w.ImageName)"
                                 alt="@w.Name"
                                 class="catalog-image" loading="lazy" decoding="async"
                                 width="360" height="210" />

                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1" Color="Color.Primary">@w.Name</MudText>
                                <MudText Typo="Typo.caption">@w.Type</MudText>
                                <MudText Typo="Typo.body2" Class="line-clamp-3">@w.Description</MudText>
                            </MudCardContent>

                            <MudCardActions>
                                <MudSelect T="string" Value="@w.OwnershipState"
                                           ValueChanged="@(value => ChangeStateAsync(w, value))"
                                           Label="Estado" Dense="true"
                                           Disabled="@string.IsNullOrEmpty(userId)"
                                           Class="ownership-select">
                                    <MudSelectItem T="string" Value="@("missing")">Pendiente</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("blueprint")">Solo plano</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("set")">Set completo</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("built")">Construida</MudSelectItem>
                                </MudSelect>
                                <MudSpacer />
                                <MudButton Variant="Variant.Text" Color="Color.Primary"
                                           Href="@($"/weapons/{Uri.EscapeDataString(w.UniqueName)}")">
                                    Ver detalle
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>

            <div class="d-flex justify-center mt-6">
                <MudPagination Selected="@currentPage"
                               Count="@totalPages"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary"
                               Size="Size.Medium" />
            </div>
        }
    </MudStack>
</MudContainer>

@code {
    private List<WeaponViewModel> pagedWeapons = new();
    private bool loading = true;
    private string? searchTerm = "";
    private int currentPage = 1;
    private int totalPages = 1;
    private const int pageSize = 10;
    private string userId = "";

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("============== DEBUG WEAPONS ==============");
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        Console.WriteLine($"👤 Usuario autenticado: {user.Identity?.Name} ({userId})");

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        currentPage = 1;
        await LoadPageAsync(currentPage);
    }

    private async Task LoadPageAsync(int page)
    {
        try
        {
            loading = true;
            StateHasChanged();

            var query = Db.Weapons.AsNoTracking().AsQueryable();
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                string term = searchTerm.ToLower();
                query = query.Where(w => EF.Functions.Like(w.Name, $"%{term}%"));
            }

            var totalCount = await query.CountAsync();
            totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
            currentPage = Math.Clamp(page, 1, totalPages);

            var result = await query
                .OrderBy(w => w.Name)
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();

            Console.WriteLine($"📦 Armas cargadas: {result.Count}");
            Console.WriteLine($"📊 Buscando UserWeapons para este usuario...");

            var pageKeys = result.Select(x => x.UniqueName).ToList();
            var ownedList = await Db.UserWeapons.AsNoTracking()
                .Where(u => u.UserId == userId && pageKeys.Contains(u.WeaponUnique))
                .ToListAsync();

            Console.WriteLine($"📊 Registros de usuario encontrados: {ownedList.Count}");
            foreach (var o in ownedList)
                Console.WriteLine($"   -> {o.WeaponUnique}, Owned={o.Owned}");

            pagedWeapons = result.Select(w => new WeaponViewModel
            {
                Id = w.Id,
                UniqueName = w.UniqueName,
                Name = w.Name,
                Description = w.Description,
                Type = w.Type,
                ImageName = w.ImageName,
                IsOwned = ownedList.Any(o => o.WeaponUnique == w.UniqueName && o.Owned),
                OwnershipState = ownedList.FirstOrDefault(o => o.WeaponUnique == w.UniqueName) is { } row
                    ? NormalizeState(row.OwnershipState, row.Owned) : "missing"
            }).ToList();

            loading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error cargando armas: {ex}");
        }
    }

    private async Task ToggleOwnedAsync(WeaponViewModel weapon, bool value)
    {
        Console.WriteLine($"🟡 ToggleOwnedAsync → {weapon.Name} = {value}");
        Console.WriteLine($"   Usuario actual: {userId}");

        try
        {
            if (string.IsNullOrWhiteSpace(userId))
            {
                Console.WriteLine("❌ userId vacío. No se guardará nada.");
                return;
            }

            var existing = await Db.UserWeapons
                .FirstOrDefaultAsync(x => x.UserId == userId && x.WeaponUnique == weapon.UniqueName);

            if (existing == null)
            {
                Console.WriteLine($"➕ No existía registro, creando nuevo.");
                existing = new UserWeapon
                {
                    UserId = userId,
                    WeaponUnique = weapon.UniqueName,
                    Owned = value
                };
                Db.UserWeapons.Add(existing);
            }
            else
            {
                Console.WriteLine($"🔁 Actualizando existente: {existing.WeaponUnique} → {value}");
                existing.Owned = value;
            }

            var result = await Db.SaveChangesAsync();
            Console.WriteLine($"✅ SaveChanges resultado: {result} filas afectadas.");
            weapon.IsOwned = value;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error al guardar {weapon.Name}: {ex}");
        }
    }
    private async Task ChangeStateAsync(WeaponViewModel weapon, string state)
    {
        if (string.IsNullOrWhiteSpace(userId)) return;
        var existing = await Db.UserWeapons.FirstOrDefaultAsync(
            x => x.UserId == userId && x.WeaponUnique == weapon.UniqueName);
        if (existing is null)
        {
            existing = new UserWeapon { UserId = userId, WeaponUnique = weapon.UniqueName };
            Db.UserWeapons.Add(existing);
        }
        existing.OwnershipState = state;
        existing.Owned = state == "built";
        await Db.SaveChangesAsync();
        weapon.OwnershipState = state;
        weapon.IsOwned = existing.Owned;
    }
    private static string NormalizeState(string? state, bool owned)
        => string.IsNullOrWhiteSpace(state) || state == "missing" && owned ? owned ? "built" : "missing" : state;

    private async Task OnPageChanged(int newPage)
    {
        if (newPage == currentPage || newPage < 1 || newPage > totalPages)
            return;
        await LoadPageAsync(newPage);
    }

    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "/images/item-placeholder.svg"
            : $"https://cdn.warframestat.us/img/{imageName}";

    private class WeaponViewModel
    {
        public int Id { get; set; }
        public string UniqueName { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string? Type { get; set; }
        public string? ImageName { get; set; }
        public bool IsOwned { get; set; }
        public string OwnershipState { get; set; } = "missing";
    }
}
