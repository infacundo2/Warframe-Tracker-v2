@page "/weapons"
@using Microsoft.EntityFrameworkCore
@inject WarframeInventory.Data.ApplicationDbContext Db

<MudText Typo="Typo.h4" Class="mb-4">Armas</MudText>

<MudPaper Class="p-4">
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (weapons?.Count == 0)
    {
        <MudText>No se encontraron armas.</MudText>
    }
    else
    {
        <MudGrid>
            @foreach (var w in weapons)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Class="mb-4">
                        <img src="@GetImageUrl(w.ImageName)" alt="@w.Name"
                             style="width:100%;height:200px;object-fit:cover;" />

                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1">@w.Name</MudText>
                            <MudText Typo="Typo.caption">@w.Type</MudText>
                            <MudText Typo="Typo.body2">@w.Description</MudText>
                        </MudCardContent>

                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                       Href="@($"/weapons/{Uri.EscapeDataString(w.UniqueName)}")">
                                Ver detalle
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>

@code {
    private List<WarframeInventory.Models.Weapon>? weapons;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            weapons = await Db.Weapons
                .OrderBy(w => w.Name)
                .ToListAsync();
        }
        catch
        {
            weapons = new();
        }
        loading = false;
    }

    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "_content/MudBlazor/images/placeholder.png"
            : $"https://cdn.warframestat.us/img/{imageName}";
}
