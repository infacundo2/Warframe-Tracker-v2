@page "/weapons"
@inject WarframeInventory.Services.WarframeApiService Api

<MudText Typo="Typo.h4" Class="mb-4">Armas</MudText>

<MudPaper Class="p-4">
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (weapons?.Count == 0)
    {
        <MudText>No se encontraron Armas.</MudText>
    }
    else
    {
        <MudGrid>
            @foreach (var w in weapons)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Class="mb-4">
                        <img src="@GetImageUrl(w.ImageName)" alt="@w.Name" style="width:100%;height:200px;object-fit:cover;" />
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1">@w.Name</MudText>
                            <MudText Typo="Typo.caption">
                                @($"Tipo: {w.Type ?? "-"} · MR: {w.MasteryReq?.ToString() ?? "-"} · {(w.IsPrime ? "Prime" : "Normal")}")
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(w.Description))
                            {
                                <MudText Typo="Typo.body2">@w.Description</MudText>
                            }
                        </MudCardContent>
                        <MudCardActions>
                            <MudCheckBox T="bool" @bind-Checked="w.Owned" Label="Lo tengo" Color="Color.Success" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>

@code {
    private List<WarframeInventory.Models.Weapon>? weapons;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try { weapons = await Api.GetWeaponsAsync(); }
        catch { weapons = new(); }
        loading = false;
    }

    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "_content/MudBlazor/images/placeholder.png"
            : $"https://cdn.warframestat.us/img/{imageName}";
}
