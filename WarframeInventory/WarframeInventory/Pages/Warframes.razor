@page "/warframes"

@using Microsoft.EntityFrameworkCore
@inject WarframeInventory.Data.ApplicationDbContext Db
@inject AuthenticationStateProvider AuthState
@using WarframeInventory.Models
@using MudBlazor
@using System.Security.Claims

<MudContainer  MaxWidth="MaxWidth.False"
              Class="px-6 py-4 min-h-[80vh] flex flex-col justify-start">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h4" Color="Color.Primary">Warframes</MudText>

        <MudTextField @bind-Value="searchTerm"
                      Placeholder="Buscar Warframe..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="350"
                      OnDebounceIntervalElapsed="RefreshAsync"
                      Class="catalog-toolbar" />

        @if (loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mx-auto my-8" />
        }
        else if (pagedWarframes.Count == 0)
        {
            <MudText Typo="Typo.body1" Align="Align.Center" Class="mt-4">No se encontraron Warframes.</MudText>
        }
        else
        {
            <MudGrid GutterSize="3">
                @foreach (var wf in pagedWarframes)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Class="mb-4">
                            <img src="@wf.TempImage"
                                 alt="@wf.Name"
                                 class="catalog-image" loading="lazy" decoding="async"
                                 width="360" height="210" />

                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1" Color="Color.Primary">@wf.Name</MudText>
                                <MudText Typo="Typo.body2" Class="line-clamp-3">@wf.Description</MudText>
                            </MudCardContent>

                            <MudCardActions>
                                <MudSelect T="string" Value="@wf.OwnershipState"
                                           ValueChanged="@(value => ChangeStateAsync(wf, value))"
                                           Label="Estado" Dense="true"
                                           Disabled="@string.IsNullOrEmpty(userId)"
                                           Class="ownership-select">
                                    <MudSelectItem T="string" Value="@("missing")">Pendiente</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("blueprint")">Solo plano</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("set")">Set completo</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("built")">Construido</MudSelectItem>
                                </MudSelect>

                                <MudSpacer />
                                <MudButton Variant="Variant.Text" Color="Color.Primary"
                                           Href="@($"/warframes/{Uri.EscapeDataString(wf.UniqueName)}")">
                                    Ver detalle
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>

            <div class="d-flex justify-center mt-6">
                <MudPagination Selected="@currentPage"
                               Count="@totalPages"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary"
                               Size="Size.Medium" />
            </div>
        }
    </MudStack>
</MudContainer>

@code {
    private List<WarframeViewModel> pagedWarframes = new();
    private string userId = "";
    private bool loading = true;
    private string? searchTerm = "";
    private int currentPage = 1;
    private int totalPages = 1;
    private const int pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("============== DEBUG WARFRAMES ==============");
        Console.WriteLine($"🔹 Entrando a OnInitializedAsync");

        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

        Console.WriteLine($"👤 Usuario autenticado: {user.Identity?.Name} ({userId})");
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        currentPage = 1;
        await LoadPageAsync(currentPage);
    }

    private async Task LoadPageAsync(int page)
    {
        try
        {
            loading = true;
            StateHasChanged();

            var query = Db.Warframes.AsNoTracking().AsQueryable();
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                string term = searchTerm.ToLower();
                query = query.Where(w => EF.Functions.Like(w.Name, $"%{term}%"));
            }

            var totalCount = await query.CountAsync();
            totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
            currentPage = Math.Clamp(page, 1, totalPages);

            var result = await query
                .OrderBy(w => w.Name)
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();
            
            Console.WriteLine("🔹 Consultando UserWarframes para este usuario...");


            var pageKeys = result.Select(x => x.UniqueName).ToList();
            var ownedList = await Db.UserWarframes.AsNoTracking()
                .Where(u => u.UserId == userId && pageKeys.Contains(u.WarframeUnique))
                .ToListAsync();

            Console.WriteLine($"📊 Registros encontrados en UserWarframes para este usuario: {ownedList.Count}");
                foreach (var o in ownedList)
                    Console.WriteLine($"   -> {o.WarframeUnique}, Owned={o.Owned}");

            pagedWarframes = result.Select(w => new WarframeViewModel
            {
                Id = w.Id,
                UniqueName = w.UniqueName,
                Name = w.Name,
                Description = w.Description,
                ImageName = w.ImageName,
                TempImage = string.IsNullOrWhiteSpace(w.ImageName)
                    ? "/images/item-placeholder.svg"
                    : $"https://cdn.warframestat.us/img/{w.ImageName}",
                Loaded = true,
                IsOwned = ownedList.Any(o => o.WarframeUnique == w.UniqueName && o.Owned),
                OwnershipState = ownedList.FirstOrDefault(o => o.WarframeUnique == w.UniqueName) is { } row
                    ? NormalizeState(row.OwnershipState, row.Owned) : "missing"
            }).ToList();

            loading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error cargando warframes: {ex.Message}");
        }
    }

    private async Task ToggleOwnedAsync(WarframeViewModel wf, bool value)
    {
        Console.WriteLine($"🟡 ToggleOwnedAsync → {wf.Name} = {value}");
        Console.WriteLine($"   Usuario actual: {userId}");

        try
        {
            if (string.IsNullOrWhiteSpace(userId))
            {
                Console.WriteLine("❌ userId vacío. No se guardará nada.");
                return;
            }

            var existing = await Db.UserWarframes
                .FirstOrDefaultAsync(x => x.UserId == userId && x.WarframeUnique == wf.UniqueName);

            if (existing == null)
            {
                Console.WriteLine($"➕ No existía registro, creando nuevo.");
                existing = new UserWarframe
                {
                    UserId = userId,
                    WarframeUnique = wf.UniqueName,
                    Owned = value
                };
                Db.UserWarframes.Add(existing);
            }
            else
            {
                Console.WriteLine($"🔁 Actualizando existente: {existing.WarframeUnique} → {value}");
                existing.Owned = value;
            }

            var result = await Db.SaveChangesAsync();
            Console.WriteLine($"✅ SaveChanges resultado: {result} filas afectadas.");
            wf.IsOwned = value;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error al guardar {wf.Name}: {ex}");
        }
    }
    private async Task ChangeStateAsync(WarframeViewModel wf, string state)
    {
        if (string.IsNullOrWhiteSpace(userId)) return;
        var existing = await Db.UserWarframes.FirstOrDefaultAsync(
            x => x.UserId == userId && x.WarframeUnique == wf.UniqueName);
        if (existing is null)
        {
            existing = new UserWarframe { UserId = userId, WarframeUnique = wf.UniqueName };
            Db.UserWarframes.Add(existing);
        }
        existing.OwnershipState = state;
        existing.Owned = state == "built";
        await Db.SaveChangesAsync();
        wf.OwnershipState = state;
        wf.IsOwned = existing.Owned;
    }
    private static string NormalizeState(string? state, bool owned)
        => string.IsNullOrWhiteSpace(state) || state == "missing" && owned ? owned ? "built" : "missing" : state;


    private async Task OnPageChanged(int newPage)
    {
        if (newPage == currentPage || newPage < 1 || newPage > totalPages)
            return;
        await LoadPageAsync(newPage);
    }

    private class WarframeViewModel
    {
        public int Id { get; set; }
        public string UniqueName { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string? ImageName { get; set; }
        public string TempImage { get; set; } = "";
        public bool Loaded { get; set; }
        public bool IsOwned { get; set; }
        public string OwnershipState { get; set; } = "missing";
    }
}
