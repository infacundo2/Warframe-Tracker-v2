@page "/relic-sync"
@page "/account-sync"
@attribute [Authorize]
@using System.Security.Claims
@inject RelicSyncService SyncService
@inject AuthenticationStateProvider AuthState

<PageTitle>Sincronización de cuenta</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="relic-sync-page">
    <section class="orokin-panel relic-sync-hero">
        <div>
            <div class="eyebrow">ENLACE DE CUENTA // ALECAFRAME</div>
            <MudText Typo="Typo.h3" Class="page-title">Sincronización de cuenta</MudText>
            <MudText>
                Importa Créditos, Endo, Ducados, Aya, Platino, progreso de cuenta y todas tus
                reliquias sin entregar credenciales de Warframe.
            </MudText>
        </div>
        <div class="relic-sync-status @(status.HasSavedToken ? "is-connected" : "")">
            <MudIcon Icon="@(status.HasSavedToken
                              ? Icons.Material.Filled.Link
                              : Icons.Material.Filled.LinkOff)" />
            <div>
                <span>@(status.HasSavedToken ? "TOKEN CIFRADO" : "SIN CONEXIÓN")</span>
                <strong>@StatusText</strong>
            </div>
        </div>
    </section>

    @if (accountSnapshot is not null)
    {
        <section class="orokin-panel account-sync-summary mt-4">
            <div class="relic-sync-preview__heading">
                <div>
                    <div class="eyebrow">PERFIL TENNO // ÚLTIMO REGISTRO CONFIRMADO</div>
                    <MudText Typo="Typo.h4">
                        @(string.IsNullOrWhiteSpace(accountSnapshot.PublicUsername)
                            ? "Estado de la cuenta"
                            : accountSnapshot.PublicUsername)
                    </MudText>
                </div>
                <span class="account-sync-time">
                    Actualizado @FormatChileTime(accountSnapshot.SyncedUtc)
                </span>
            </div>
            <div class="account-sync-grid">
                @AccountCard("Créditos", accountSnapshot.Credits, "CR")
                @AccountCard("Endo", accountSnapshot.Endo, "ENDO")
                @AccountCard("Ducados", accountSnapshot.Ducats, "DUC")
                @AccountCard("Aya", accountSnapshot.Aya, "AYA")
                @AccountCard("Platino", accountSnapshot.Platinum, "PL")
                @AccountCard("Maestría", accountSnapshot.MasteryRank, "MR")
                @AccountCard("Colección", accountSnapshot.CompletionPercentage, "%")
                @AccountCard("Reliquias abiertas", accountSnapshot.RelicsOpened, "OPEN")
            </div>
        </section>
    }

    <MudGrid Class="mt-4">
        <MudItem xs="12" md="5">
            <MudPaper Class="relic-sync-card">
                <MudText Typo="Typo.h5">1. Crear el enlace</MudText>
                <ol class="relic-sync-steps">
                    <li>Abre AlecaFrame y entra en <b>Stats</b>.</li>
                    <li>Selecciona <b>Create Public Link</b>.</li>
                    <li>
                        Activa <b>Platinum, Ducats, Endo, Credits, Account Data, Aya</b>
                        y <b>Relics</b>.
                    </li>
                    <li>Deja <b>Trades</b> apagado si no quieres compartir el historial.</li>
                    <li>Genera el enlace y copia su token.</li>
                </ol>
                <a class="relic-sync-doc-link"
                   href="https://docs.alecaframe.com/api"
                   target="_blank" rel="noopener noreferrer">
                    Ver instrucciones oficiales
                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                </a>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
                    Si AlecaFrame está desactualizado, entra a un repetidor o dojo y vuelve al
                    orbitador antes de analizar.
                </MudAlert>
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                    El enlace público de AlecaFrame no expone Warframes, armas, mods ni recursos
                    individuales. Esos catálogos no se marcarán automáticamente.
                </MudAlert>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudPaper Class="relic-sync-card">
                <MudText Typo="Typo.h5">2. Analizar cuenta</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">
                    El análisis no cambia nada. Primero verás el perfil y las reliquias que se
                    actualizarían.
                </MudText>
                <MudTextField T="string"
                              @bind-Value="token"
                              Label="Token público de AlecaFrame"
                              Placeholder="Pega el token o usa el que ya está guardado"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.VpnKey"
                              Disabled="@busy" />
                <MudCheckBox T="bool"
                             @bind-Checked="rememberToken"
                             Label="Guardar token cifrado para próximas sincronizaciones"
                             Color="Color.Primary"
                             Disabled="@busy" />
                <div class="relic-sync-actions">
                    <MudButton OnClick="PreviewAsync"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ManageSearch"
                               Disabled="@busy">
                        Analizar ahora
                    </MudButton>
                    @if (status.HasSavedToken)
                    {
                        <MudButton OnClick="DisconnectAsync"
                                   Variant="Variant.Text"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.LinkOff"
                                   Disabled="@busy">
                            Olvidar token
                        </MudButton>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (busy)
    {
        <MudPaper Class="relic-sync-progress mt-4">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <div>
                <b>@busyMessage</b>
                <span>Consultando el perfil y relacionando las reliquias de forma segura.</span>
            </div>
        </MudPaper>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <MudAlert Severity="@messageSeverity" Class="mt-4" Variant="Variant.Outlined">
            @message
        </MudAlert>
    }

    @if (preview is not null)
    {
        <section class="orokin-panel relic-sync-preview mt-4">
            <div class="relic-sync-preview__heading">
                <div>
                    <div class="eyebrow">VISTA PREVIA // NINGÚN CAMBIO APLICADO</div>
                    <MudText Typo="Typo.h4">Confirma la sincronización</MudText>
                </div>
                <MudButton OnClick="ApplyAsync"
                           Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.DoneAll"
                           Disabled="@busy">
                    Aplicar perfil y @preview.Changes.Count reliquias
                </MudButton>
            </div>

            <MudText Typo="Typo.h5" Class="mb-3">Perfil recibido</MudText>
            <div class="account-sync-grid account-sync-grid--preview">
                @PreviewAccountCard("Créditos", preview.AccountStats.Credits, preview.PreviousAccount?.Credits, "CR")
                @PreviewAccountCard("Endo", preview.AccountStats.Endo, preview.PreviousAccount?.Endo, "ENDO")
                @PreviewAccountCard("Ducados", preview.AccountStats.Ducats, preview.PreviousAccount?.Ducats, "DUC")
                @PreviewAccountCard("Aya", preview.AccountStats.Aya, preview.PreviousAccount?.Aya, "AYA")
                @PreviewAccountCard("Platino", preview.AccountStats.Platinum, preview.PreviousAccount?.Platinum, "PL")
                @PreviewAccountCard("Maestría", preview.AccountStats.MasteryRank, preview.PreviousAccount?.MasteryRank, "MR")
                @PreviewAccountCard("Colección", preview.AccountStats.CompletionPercentage, preview.PreviousAccount?.CompletionPercentage, "%")
                @PreviewAccountCard("Reliquias abiertas", preview.AccountStats.RelicsOpened, preview.PreviousAccount?.RelicsOpened, "OPEN")
            </div>

            <MudText Typo="Typo.h5" Class="mb-3">Inventario de reliquias</MudText>
            <div class="relic-sync-metrics">
                <div><span>Entradas recibidas</span><b>@preview.SourceCount</b></div>
                <div><span>Variantes reconocidas</span><b>@preview.MatchedCount</b></div>
                <div><span>Aumentan o cambian</span><b>@IncreaseCount</b></div>
                <div><span>Quedan en cero</span><b>@RemovalCount</b></div>
            </div>

            @if (!preview.IsAuthoritative)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                    AlecaFrame envió @preview.SkippedRecords
                    @(preview.SkippedRecords == 1 ? "registro incompleto" : "registros incompletos").
                    Recuperamos el resto del inventario y activamos el modo seguro: se actualizarán
                    las reliquias reconocidas, pero ninguna reliquia local ausente quedará en cero.
                </MudAlert>
            }

            @if (preview.UnknownRelics.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                    @preview.UnknownRelics.Count entradas no existen todavía en el catálogo local
                    y se omitirán: @string.Join(", ", preview.UnknownRelics.Take(8))
                    @(preview.UnknownRelics.Count > 8 ? "…" : "")
                </MudAlert>
            }

            @if (preview.Changes.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                    Tus reliquias locales ya coinciden con AlecaFrame. Aún puedes confirmar para
                    actualizar el perfil de cuenta y su fecha.
                </MudAlert>
            }
            else
            {
                <MudTextField T="string"
                              @bind-Value="changeFilter"
                              Label="Filtrar cambios"
                              Immediate="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="mb-3" />
                <div class="relic-sync-table-wrap">
                    <table class="relic-sync-table">
                        <thead>
                            <tr>
                                <th>Reliquia</th>
                                <th>Refinamiento</th>
                                <th>Actual</th>
                                <th>Nuevo</th>
                                <th>Cambio</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var change in FilteredChanges)
                            {
                                <tr>
                                    <td>@change.Name</td>
                                    <td><span class="refinement-chip">@ShortRefinement(change.Refinement) · @change.Refinement</span></td>
                                    <td>@change.PreviousQuantity</td>
                                    <td><b>@change.NewQuantity</b></td>
                                    <td class="@(change.NewQuantity > change.PreviousQuantity
                                                     ? "change-positive"
                                                     : "change-negative")">
                                        @SignedDifference(change)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    <MudPaper Class="relic-sync-privacy mt-4">
        <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" />
        <div>
            <b>Qué guardamos</b>
            <span>
                Solo el token público cifrado, el último estado del perfil y las cantidades de
                reliquias. No almacenamos el historial de intercambios ni solicitamos correo,
                contraseña o código de Warframe.
            </span>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private string userId = "";
    private string token = "";
    private string changeFilter = "";
    private bool rememberToken = true;
    private bool busy;
    private string busyMessage = "";
    private string message = "";
    private Severity messageSeverity = Severity.Info;
    private RelicSyncStatus status = RelicSyncStatus.Empty;
    private RelicSyncPreview? preview;
    private AlecaAccountSnapshot? accountSnapshot;

    protected override async Task OnInitializedAsync()
    {
        var authentication = await AuthState.GetAuthenticationStateAsync();
        userId = authentication.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        status = await SyncService.GetStatusAsync(userId);
        accountSnapshot = await SyncService.GetAccountSnapshotAsync(userId);
    }

    private string StatusText => status.LastSyncUtc is null
        ? "Aún no sincronizado"
        : $"Última sincronización: {FormatChileTime(status.LastSyncUtc.Value)}";

    private int IncreaseCount => preview?.Changes.Count(x =>
        x.NewQuantity > x.PreviousQuantity) ?? 0;

    private int RemovalCount => preview?.Changes.Count(x =>
        x.PreviousQuantity > 0 && x.NewQuantity == 0) ?? 0;

    private IEnumerable<RelicSyncChange> FilteredChanges =>
        string.IsNullOrWhiteSpace(changeFilter)
            ? preview?.Changes ?? []
            : preview?.Changes.Where(x =>
                x.Name.Contains(changeFilter, StringComparison.CurrentCultureIgnoreCase)
                || x.Refinement.Contains(changeFilter, StringComparison.CurrentCultureIgnoreCase))
              ?? [];

    private async Task PreviewAsync()
    {
        await RunBusyAsync("Leyendo cuenta de AlecaFrame", async () =>
        {
            preview = await SyncService.PreviewAsync(userId, token, rememberToken);
            status = await SyncService.GetStatusAsync(userId);
            message = preview.Changes.Count == 0
                ? "Perfil recibido; las reliquias ya coinciden."
                : $"Perfil recibido y {preview.Changes.Count} cambios de reliquias pendientes.";
            messageSeverity = preview.UnknownRelics.Count > 0 || !preview.IsAuthoritative
                ? Severity.Warning
                : Severity.Info;
            if (rememberToken)
                token = "";
        });
    }

    private async Task ApplyAsync()
    {
        if (preview is null)
            return;
        await RunBusyAsync("Aplicando perfil e inventario confirmado", async () =>
        {
            var result = await SyncService.ApplyAsync(userId, preview);
            preview = null;
            changeFilter = "";
            status = await SyncService.GetStatusAsync(userId);
            accountSnapshot = await SyncService.GetAccountSnapshotAsync(userId);
            message = $"Cuenta sincronizada: perfil actualizado y {result.RelicChanges} cantidades de reliquias modificadas.";
            messageSeverity = Severity.Success;
        });
    }

    private async Task DisconnectAsync()
    {
        await RunBusyAsync("Eliminando el enlace guardado", async () =>
        {
            await SyncService.DisconnectAsync(userId);
            status = await SyncService.GetStatusAsync(userId);
            preview = null;
            token = "";
            message = "El token cifrado fue eliminado. El perfil y el inventario guardados no se modificaron.";
            messageSeverity = Severity.Info;
        });
    }

    private RenderFragment AccountCard(string label, long? value, string unit) => @<div>
        <span>@label</span>
        <b>@FormatAccountValue(value)</b>
        <small>@unit</small>
    </div>;

    private RenderFragment PreviewAccountCard(
        string label,
        long? value,
        long? previous,
        string unit) => @<div class="@(value is null ? "is-unavailable" : "")">
        <span>@label</span>
        <b>@FormatAccountValue(value)</b>
        <small>@AccountDifference(value, previous, unit)</small>
    </div>;

    private static string FormatAccountValue(long? value)
        => value?.ToString("N0") ?? "Sin permiso";

    private static string AccountDifference(long? value, long? previous, string unit)
    {
        if (value is null)
            return "No compartido";
        if (previous is null)
            return $"Nuevo · {unit}";
        var difference = value.Value - previous.Value;
        if (difference == 0)
            return $"Sin cambio · {unit}";
        return $"{(difference > 0 ? "+" : "")}{difference:N0} · {unit}";
    }

    private async Task RunBusyAsync(string operation, Func<Task> action)
    {
        busy = true;
        busyMessage = operation;
        message = "";
        try
        {
            await action();
        }
        catch (RelicSyncException exception)
        {
            message = exception.Message;
            messageSeverity = Severity.Error;
        }
        catch
        {
            message = "Ocurrió un error inesperado. El inventario no fue modificado.";
            messageSeverity = Severity.Error;
        }
        finally
        {
            busy = false;
        }
    }

    private static string ShortRefinement(string refinement) => refinement switch
    {
        "Intacta" => "I",
        "Excepcional" => "E",
        "Perfecta" => "P",
        "Radiante" => "R",
        _ => "?"
    };

    private static string SignedDifference(RelicSyncChange change)
    {
        var difference = change.NewQuantity - change.PreviousQuantity;
        return difference > 0 ? $"+{difference}" : difference.ToString();
    }

    private static string FormatChileTime(DateTime utc)
    {
        try
        {
            var zoneId = OperatingSystem.IsWindows()
                ? "Pacific SA Standard Time"
                : "America/Santiago";
            var local = TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.SpecifyKind(utc, DateTimeKind.Utc),
                TimeZoneInfo.FindSystemTimeZoneById(zoneId));
            return local.ToString("dd-MM-yyyy HH:mm");
        }
        catch
        {
            return utc.ToString("dd-MM-yyyy HH:mm 'UTC'");
        }
    }
}
