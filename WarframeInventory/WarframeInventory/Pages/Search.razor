@page "/search"
@inject UniversalSearchService SearchService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject ILogger<Search> Logger
@using System.Security.Claims
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <section class="search-console orokin-panel">
        <div class="eyebrow">CONSOLA UNIVERSAL // CTRL + K</div>
        <MudText Typo="Typo.h3" Class="page-title">Consulta el archivo</MudText>
        <div class="search-console__input">
            <MudIcon Icon="@Icons.Material.Filled.Search" Color="Color.Primary" />
            <input id="universal-search-input"
                   value="@query"
                   @oninput="OnInput"
                   placeholder="Warframe, arma, mod, reliquia o componente..."
                   autocomplete="off" />
            <kbd>ESC</kbd>
        </div>
        <div class="search-categories">
            @foreach (var option in Categories)
            {
                <button type="button" class="@(category == option.Key ? "is-active" : "")"
                        @onclick="@(() => ChangeCategoryAsync(option.Key))">@option.Value</button>
            }
        </div>
        <div class="search-examples">
            <span>Prueba:</span>
            @foreach (var example in Examples)
            {
                <button type="button" @onclick="@(() => RunExampleAsync(example))">@example</button>
            }
        </div>
    </section>

    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@errorMessage</MudAlert>
    }
    else if (query.Length >= 2 && results.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">No se encontraron coincidencias.</MudAlert>
    }
    else
    {
        <div class="search-results">
            @foreach (var hit in results)
            {
                <button type="button" class="search-hit" @onclick="@(() => Nav.NavigateTo(hit.Route))">
                    <img src="@ImageUrl(hit.ImageName)" alt="" />
                    <span>
                        <small>@Label(hit.Category)</small>
                        <b>@DisplayName(hit)</b>
                        <em>@DisplaySubtitle(hit)</em>
                    </span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                </button>
            }
        </div>
    }
</MudContainer>

@code {
    private static readonly Dictionary<string, string> Categories = new()
    {
        ["all"] = "Todo", ["warframe"] = "Warframes", ["weapon"] = "Armas",
        ["mod"] = "Mods", ["relic"] = "Reliquias", ["component"] = "Componentes"
    };
    private string query = "";
    private string category = "all";
    private bool loading;
    private string? errorMessage;
    private IReadOnlyList<SearchHit> results = [];
    private CancellationTokenSource? searchCts;
    private string userId = "";
    private static readonly string[] Examples =
        ["reliquias en bóveda que poseo", "armas Prime incompletas",
         "reliquias con Ash Systems", "mods para Trinity"];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
    }

    private async Task OnInput(ChangeEventArgs args)
    {
        query = args.Value?.ToString() ?? "";
        await SearchNowAsync(category, debounce: true);
    }

    private async Task SearchNowAsync(string requestedCategory, bool debounce)
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;
        if (query.Trim().Length < 2)
        {
            results = [];
            errorMessage = null;
            loading = false;
            return;
        }
        loading = true;
        errorMessage = null;
        try
        {
            if (debounce)
                await Task.Delay(220, token);
            results = await SearchService.SearchAsync(query, requestedCategory, userId, token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!token.IsCancellationRequested)
            {
                results = [];
                errorMessage = "La búsqueda no pudo completarse. Inténtalo nuevamente.";
                Logger.LogError(ex, "Universal search failed for category {Category}", requestedCategory);
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
                loading = false;
        }
    }

    private async Task ChangeCategoryAsync(string value)
    {
        category = value;
        if (query.Trim().Length >= 2)
            await SearchNowAsync(category, debounce: false);
    }
    private async Task RunExampleAsync(string value)
    {
        query = value;
        category = "all";
        await SearchNowAsync(category, debounce: false);
    }

    public void Dispose()
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
    }

    private static string Label(string value) => Categories.GetValueOrDefault(value, value);
    private static string DisplayName(SearchHit hit)
        => hit.Category == "component"
            ? WarframeSpanishText.Reward(hit.Name)
            : hit.Name;
    private static string DisplaySubtitle(SearchHit hit)
        => hit.Subtitle.Equals("Vaulted", StringComparison.OrdinalIgnoreCase)
            ? "En bóveda"
            : hit.Category is "weapon" or "mod"
                ? WarframeSpanishText.Type(hit.Subtitle)
                : hit.Subtitle;
    private static string ImageUrl(string? image)
        => string.IsNullOrWhiteSpace(image) ? "/images/item-placeholder.svg"
            : $"https://cdn.warframestat.us/img/{image}";
}
