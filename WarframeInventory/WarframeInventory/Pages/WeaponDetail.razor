@page "/weapons/{uniqueName}"
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using System.Text.Json
@using WarframeInventory.Models
@using MudBlazor
@inject WarframeInventory.Data.ApplicationDbContext Db
@inject AuthenticationStateProvider AuthState

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (weapon == null)
    {
        <MudText Typo="Typo.h6" Color="Color.Error">No se encontró el arma solicitada.</MudText>
    }
    else
    {
        <MudPaper Class="p-6">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <img src="@GetImageUrl(weapon.ImageName)" alt="@weapon.Name" style="width:100%;border-radius:8px;" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h4" Color="Color.Primary">@weapon.Name</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2 mb-3">@weapon.Description</MudText>

                    <MudText Typo="Typo.subtitle2">Detalles</MudText>
                    <MudList Dense="true">
                        <MudListItem>Tipo: @weapon.Type</MudListItem>
                        <MudListItem>Requisito de maestría: @weapon.MasteryReq</MudListItem>
                        <MudListItem>¿Prime?: @(weapon.IsPrime ? "Sí" : "No")</MudListItem>
                    </MudList>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Componentes</MudText>

            @if (components == null || components.Count == 0)
            {
                <MudText Typo="Typo.caption">Sin componentes registrados.</MudText>
            }
            else
            {
                @foreach (var c in components)
                {
                    <MudPaper Class="p-3 mb-3" Elevation="1">
                        <MudGrid>
                            <MudItem xs="12" md="4">
                                <img src="@GetImageUrl(c.ImageName)" alt="@c.Name" style="width:100%;border-radius:8px;" />
                            </MudItem>

                            <MudItem xs="12" md="8">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Primary">@c.Name</MudText>

                                    <MudStack Direction="Row" AlignItems="@AlignItems.Center" Spacing="2">
                                        <MudCheckBox T="bool"
                                                    Checked="@c.Owned"
                                                    Label="Tengo este componente"
                                                    Color="Color.Success"
                                                    CheckedChanged="@(async (bool v) => { c.Owned = v; await UpdateComponentAsync(c); })" />

                                        <MudNumericField T="int"
                                                        Value="@c.Quantity"
                                                        Label="Cantidad"
                                                        Min="0" Max="99"
                                                        Immediate="true"
                                                        Class="w-24"
                                                        ValueChanged="@(async (int v) => { c.Quantity = v; await UpdateComponentAsync(c); })" />
                                    </MudStack>

                                    <MudDivider Class="my-2" />

                                    @if (c.RelicLinks != null && c.RelicLinks.Count > 0)
                                    {
                                        <MudText Typo="Typo.caption"><b>Reliquias que lo dropean:</b></MudText>
                                        @foreach (var rel in c.RelicLinks)
                                        {
                                            <MudPaper Class="p-2 mb-1" Elevation="0">
                                                <MudText Typo="Typo.body2">
                                                    <MudLink Href="@($"/relics/{Uri.EscapeDataString(rel.UniqueName)}")">@rel.Name</MudLink>
                                                    — <i style="color:@(rel.Vaulted ? "red" : "green")">
                                                        @(rel.Vaulted ? "Vaulted" : "Disponible")
                                                      </i>
                                                </MudText>
                                                <MudNumericField T="int"
                                                                 Value="@rel.Quantity"
                                                                 Label="Cantidad"
                                                                 Min="0"
                                                                 Max="99"
                                                                 Immediate="true"
                                                                 Class="w-24 mt-1" />
                                            </MudPaper>
                                        }
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption">No hay reliquias registradas.</MudText>
                                    }
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
            }
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public string? uniqueName { get; set; }

    private Weapon? weapon;
    private List<WarframeComponent>? components;
    private bool loading = true;
    private string userId = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("============== DEBUG WEAPON DETAIL ==============");
            var authState = await AuthState.GetAuthenticationStateAsync();
            var user = authState.User;
            userId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
            Console.WriteLine($"👤 Usuario autenticado: {user.Identity?.Name} ({userId})");

            if (string.IsNullOrWhiteSpace(uniqueName)) return;
            var decoded = Uri.UnescapeDataString(uniqueName);
            Console.WriteLine($"🔹 Cargando arma: {decoded}");

            weapon = await Db.Weapons.AsNoTracking().FirstOrDefaultAsync(w => w.UniqueName == decoded);
            if (weapon == null)
            {
                Console.WriteLine("❌ Arma no encontrada");
                loading = false;
                return;
            }

            if (!string.IsNullOrWhiteSpace(weapon.ComponentsJson))
            {
                components = JsonSerializer.Deserialize<List<WarframeComponent>>(weapon.ComponentsJson);
                if (components != null)
                {
                    var userComps = await Db.UserComponents
                        .Where(x => x.UserId == userId && x.ParentUnique == weapon.UniqueName)
                        .ToListAsync();

                    foreach (var c in components)
                    {
                        var match = userComps.FirstOrDefault(x => x.ComponentName == c.Name);
                        if (match != null)
                        {
                            c.Owned = match.Owned;
                            c.Quantity = match.Quantity;
                        }

                        await LoadRelicLinksAsync(c);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error en WeaponDetail: {ex}");
        }
        loading = false;
    }

    private async Task LoadRelicLinksAsync(WarframeComponent comp)
    {
        try
        {
            if (!weapon!.IsPrime || comp.Drops == null) return;

            var relicNames = comp.Drops
                .Where(d => !string.IsNullOrWhiteSpace(d.Location) && d.Location.Contains("Relic", StringComparison.OrdinalIgnoreCase))
                .Select(d => d.Location)
                .Distinct()
                .ToList();

            var relics = new List<Relic>();
            foreach (var relicNameRaw in relicNames)
            {
                var cleanName = relicNameRaw
                    .Replace("Reliquia", "", StringComparison.OrdinalIgnoreCase)
                    .Replace("Relic", "", StringComparison.OrdinalIgnoreCase)
                    .Replace(" (Radiant)", "", StringComparison.OrdinalIgnoreCase)
                    .Replace(" (Flawless)", "", StringComparison.OrdinalIgnoreCase)
                    .Replace(" (Exceptional)", "", StringComparison.OrdinalIgnoreCase)
                    .Trim();

                var core = cleanName.ToLower();
                var found = await Db.Relics.AsNoTracking()
                    .FirstOrDefaultAsync(r =>
                        r.Name.ToLower().Contains(core) || r.UniqueName.ToLower().Contains(core));

                if (found != null)
                    relics.Add(found);
            }

            if (relics.Count > 0)
                comp.RelicLinks = relics.Select(r => new RelicLink
                {
                    Name = r.Name,
                    UniqueName = r.UniqueName,
                    Vaulted = r.Vaulted,
                    Quantity = 0
                }).ToList();

            Console.WriteLine($"🧩 {comp.Name}: {relics.Count} reliquias asociadas");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠️ Error procesando reliquias de {comp.Name}: {ex.Message}");
        }
    }

    private async Task UpdateComponentAsync(WarframeComponent comp)
    {
        try
        {
            Console.WriteLine($"🟡 UpdateComponentAsync → {comp.Name} Owned={comp.Owned}, Qty={comp.Quantity}");
            if (string.IsNullOrWhiteSpace(userId)) return;

            var existing = await Db.UserComponents
                .FirstOrDefaultAsync(x => x.UserId == userId && x.ParentUnique == weapon!.UniqueName && x.ComponentName == comp.Name);

            if (existing == null)
            {
                existing = new UserComponent
                {
                    UserId = userId,
                    ParentUnique = weapon!.UniqueName,
                    ComponentName = comp.Name,
                    Owned = comp.Owned,
                    Quantity = comp.Quantity
                };
                Db.UserComponents.Add(existing);
                Console.WriteLine("➕ Nuevo componente creado.");
            }
            else
            {
                existing.Owned = comp.Owned;
                existing.Quantity = comp.Quantity;
                Console.WriteLine("🔁 Componente existente actualizado.");
            }

            var result = await Db.SaveChangesAsync();
            Console.WriteLine($"✅ Guardado OK ({result} filas afectadas)");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error guardando componente {comp.Name}: {ex.Message}");
        }
    }

    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "_content/MudBlazor/images/placeholder.png"
            : $"https://cdn.warframestat.us/img/{imageName}";
}
