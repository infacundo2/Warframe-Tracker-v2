@page "/builds"
@attribute [Authorize]
@using System.Security.Claims
@using System.Text
@using System.Text.Json
@inject BuildService BuildManager
@inject UserGoalService GoalService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime Js

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <section class="orokin-panel build-hero">
        <div class="eyebrow">ARSENAL SIMULADO // CONFIGURACIONES</div>
        <MudText Typo="Typo.h3" Class="page-title">Constructor ligero</MudText>
        <MudText>Combina mods, calcula capacidad y detecta piezas faltantes.</MudText>
    </section>
    @if (workspace is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
    }
    else
    {
        <MudPaper Class="build-editor mt-4">
            <MudTextField @bind-Value="name" Label="Nombre de la build" Variant="Variant.Outlined" />
            <MudSelect T="string" Label="Objetivo" Value="@targetUnique" ValueChanged="SelectTarget"
                       Variant="Variant.Outlined">
                @foreach (var target in workspace.Targets)
                {
                    <MudSelectItem T="string" Value="@target.UniqueName">
                        @target.Name · @target.Type
                    </MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="tags" Label="Etiquetas" Placeholder="acero, supervivencia..."
                          Variant="Variant.Outlined" />
            <MudNumericField T="int" @bind-Value="capacity" Label="Capacidad" Min="0" Max="90"
                             Variant="Variant.Outlined" />
            <MudNumericField T="int" @bind-Value="forma" Label="Forma" Min="0" Max="100"
                             Variant="Variant.Outlined" />
        </MudPaper>
        <div class="build-summary">
            <span>CAPACIDAD CON POLARIDADES <b class="@(EffectiveDrain > capacity ? "is-over" : "")">@EffectiveDrain / @capacity</b></span>
            <span>SIN POLARIDADES <b class="@(RawDrain > capacity ? "is-over" : "")">@RawDrain / @capacity</b></span>
            <span>FORMA SUGERIDA <b>@SuggestedForma</b></span>
            <span>MODS FALTANTES <b>@slots.Count(x => !x.Owned)</b></span>
        </div>
        <div class="build-slots">
            @for (var index = 0; index < 8; index++)
            {
                var slotIndex = index;
                <MudPaper Class="@($"build-slot {(slots[slotIndex].Owned ? "" : "is-missing")}")">
                    <MudSelect T="string" Label="@($"Ranura {slotIndex + 1}")"
                               Value="@slots[slotIndex].ModUnique"
                               ValueChanged="@((string value) => SelectMod(slotIndex, value))"
                               Variant="Variant.Outlined" Clearable="true">
                        @foreach (var mod in workspace.Mods)
                        {
                            <MudSelectItem T="string" Value="@mod.UniqueName">
                                @mod.Name · @mod.Drain @(mod.Owned ? "" : "· FALTA")
                            </MudSelectItem>
                        }
                    </MudSelect>
                    @if (!string.IsNullOrWhiteSpace(slots[slotIndex].ModUnique))
                    {
                        <div class="build-slot__settings">
                            <MudNumericField T="int" Value="@slots[slotIndex].Rank"
                                             ValueChanged="@((int value) => SetRank(slotIndex, value))"
                                             Label="Rango" Min="0" Max="@slots[slotIndex].MaxRank"
                                             Variant="Variant.Outlined" />
                            <MudSelect T="string" Value="@slots[slotIndex].SlotPolarity"
                                       ValueChanged="@((string value) => SetPolarity(slotIndex, value))"
                                       Label="Polaridad de ranura" Variant="Variant.Outlined"
                                       Clearable="true">
                                @foreach (var polarity in Polarities)
                                {
                                    <MudSelectItem T="string" Value="@polarity">@polarity</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                        <small>@slots[slotIndex].Polarity · @slots[slotIndex].EffectiveDrain capacidad efectiva</small>
                    }
                </MudPaper>
            }
        </div>
        <MudButton OnClick="SaveAsync" Disabled="@(!CanSave)" Variant="Variant.Filled"
                   Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save">Guardar build</MudButton>
        <MudButton OnClick="CreateMissingGoalsAsync"
                   Disabled="@(slots.All(x => x.Owned || string.IsNullOrWhiteSpace(x.ModUnique)))"
                   Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.TrackChanges">
            Crear objetivos para mods faltantes
        </MudButton>
        <MudButton OnClick="ShareAsync" Disabled="@(!CanSave)" Variant="Variant.Text"
                   Color="Color.Primary" StartIcon="@Icons.Material.Filled.Share">
            Copiar enlace
        </MudButton>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="Severity.Success" Class="mt-3">@message</MudAlert>
        }
        <MudText Typo="Typo.h5" Class="mt-6 mb-2">Builds guardadas</MudText>
        <div class="saved-builds">
            @foreach (var build in workspace.Builds)
            {
                <MudPaper Class="saved-build">
                    <span>@build.TargetName</span><b>@build.Name</b>
                    <small>@build.Tags · @build.Capacity capacidad · @build.FormaCount Forma</small>
                    <div>
                        <MudButton OnClick="@(() => LoadSaved(build))" Size="Size.Small"
                                   Variant="Variant.Text">Editar</MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       OnClick="@(() => DeleteAsync(build.Id))"
                                       Color="Color.Error" Size="Size.Small"
                                       aria-label="Eliminar build" />
                    </div>
                </MudPaper>
            }
        </div>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "share")]
    public string? SharedBuild { get; set; }
    private BuildWorkspace? workspace;
    private string userId = "", name = "", tags = "", targetUnique = "", message = "";
    private int capacity = 30, forma;
    private List<BuildSlot> slots = Enumerable.Range(0, 8)
        .Select(_ => new BuildSlot("", "", 0, "", true)).ToList();
    private int RawDrain => slots.Sum(x => x.RankedDrain);
    private int EffectiveDrain => slots.Sum(x => x.EffectiveDrain);
    private int SuggestedForma => slots.Count(x => !string.IsNullOrWhiteSpace(x.ModUnique)
        && !string.IsNullOrWhiteSpace(x.SlotPolarity));
    private IEnumerable<string> Polarities => workspace is null ? []
        : workspace.Mods.Select(x => x.Polarity)
            .Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);
    private bool CanSave => !string.IsNullOrWhiteSpace(name) && !string.IsNullOrWhiteSpace(targetUnique);
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        workspace = await BuildManager.LoadAsync(userId);
        targetUnique = workspace.Targets.FirstOrDefault()?.UniqueName ?? "";
        LoadShared();
    }
    private void SelectTarget(string value) => targetUnique = value;
    private void SelectMod(int index, string value)
    {
        var mod = workspace?.Mods.FirstOrDefault(x => x.UniqueName == value);
        slots[index] = mod is null ? new("", "", 0, "", true)
            : new(mod.UniqueName, mod.Name, mod.Drain, mod.Polarity, mod.Owned)
                { MaxRank = mod.MaxRank, Rank = mod.MaxRank };
    }
    private void SetRank(int index, int value)
        => slots[index] = slots[index] with { Rank = Math.Clamp(value, 0, slots[index].MaxRank) };
    private void SetPolarity(int index, string value)
        => slots[index] = slots[index] with { SlotPolarity = value ?? "" };
    private async Task SaveAsync()
    {
        var target = workspace!.Targets.First(x => x.UniqueName == targetUnique);
        await BuildManager.SaveAsync(userId, 0, name, target, tags, capacity, forma, slots);
        workspace = await BuildManager.LoadAsync(userId);
        message = "Build guardada en el archivo del operador.";
    }
    private async Task CreateMissingGoalsAsync()
    {
        var missing = slots.Where(x => !x.Owned && !string.IsNullOrWhiteSpace(x.ModUnique))
            .Select(x => ("mod", x.ModUnique, x.Name));
        var created = await GoalService.EnsureManyAsync(userId, missing);
        message = created == 0 ? "Los mods faltantes ya estaban en tus objetivos."
            : $"{created} objetivos de mods creados.";
    }
    private void LoadSaved(SavedBuild build)
    {
        name = build.Name;
        tags = build.Tags;
        targetUnique = build.TargetUnique;
        capacity = build.Capacity;
        forma = build.FormaCount;
        slots = NormalizeSlots(DeserializeSlots(build.ModsJson));
        message = $"Editando {build.Name}. Al guardar se creará una copia nueva.";
    }
    private async Task DeleteAsync(int id)
    {
        await BuildManager.DeleteAsync(userId, id);
        workspace = await BuildManager.LoadAsync(userId);
        message = "Build eliminada.";
    }
    private async Task ShareAsync()
    {
        var payload = new SharedBuildPayload(name, targetUnique, tags, capacity, forma, slots);
        var bytes = Encoding.UTF8.GetBytes(JsonSerializer.Serialize(payload));
        var encoded = Convert.ToBase64String(bytes).TrimEnd('=').Replace('+', '-').Replace('/', '_');
        var url = Nav.ToAbsoluteUri($"/builds?share={encoded}").ToString();
        await Js.InvokeVoidAsync("warframeTracker.copyText", url);
        message = "Enlace copiado. No incluye datos de tu cuenta.";
    }
    private void LoadShared()
    {
        if (string.IsNullOrWhiteSpace(SharedBuild)) return;
        try
        {
            var encoded = SharedBuild.Replace('-', '+').Replace('_', '/');
            encoded = encoded.PadRight(encoded.Length + (4 - encoded.Length % 4) % 4, '=');
            var payload = JsonSerializer.Deserialize<SharedBuildPayload>(
                Encoding.UTF8.GetString(Convert.FromBase64String(encoded)));
            if (payload is null || workspace is null
                || !workspace.Targets.Any(x => x.UniqueName == payload.TargetUnique)) return;
            name = payload.Name;
            targetUnique = payload.TargetUnique;
            tags = payload.Tags;
            capacity = Math.Clamp(payload.Capacity, 0, 90);
            forma = Math.Clamp(payload.Forma, 0, 100);
            slots = NormalizeSlots(payload.Slots);
            message = "Build compartida cargada. Los mods faltantes se comparan con tu inventario.";
        }
        catch (Exception) { message = "El enlace compartido no es válido."; }
    }
    private static List<BuildSlot> DeserializeSlots(string json)
    {
        try
        {
            return (JsonSerializer.Deserialize<List<BuildSlot>>(json) ?? [])
                .Take(8).Concat(Enumerable.Range(0, 8)
                    .Select(_ => new BuildSlot("", "", 0, "", true))).Take(8).ToList();
        }
        catch (JsonException) { return Enumerable.Range(0, 8)
            .Select(_ => new BuildSlot("", "", 0, "", true)).ToList(); }
    }
    private List<BuildSlot> NormalizeSlots(IEnumerable<BuildSlot> source)
    {
        var normalized = source.Take(8).Select(slot =>
        {
            var mod = workspace?.Mods.FirstOrDefault(x => x.UniqueName == slot.ModUnique);
            return mod is null ? new BuildSlot("", "", 0, "", true)
                : new BuildSlot(mod.UniqueName, mod.Name, mod.Drain, mod.Polarity, mod.Owned)
                {
                    MaxRank = mod.MaxRank,
                    Rank = Math.Clamp(slot.Rank, 0, mod.MaxRank),
                    SlotPolarity = slot.SlotPolarity
                };
        }).ToList();
        return normalized.Concat(Enumerable.Range(0, 8)
            .Select(_ => new BuildSlot("", "", 0, "", true))).Take(8).ToList();
    }
    private sealed record SharedBuildPayload(
        string Name, string TargetUnique, string Tags, int Capacity, int Forma,
        IReadOnlyList<BuildSlot> Slots);
}
