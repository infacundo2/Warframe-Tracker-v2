@page "/warframes/{uniqueName}"
@using Microsoft.EntityFrameworkCore
@inject WarframeInventory.Data.ApplicationDbContext Db
@using System.Text.Json
@using WarframeInventory.Models
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (warframe == null)
    {
        <MudText Typo="Typo.h6" Color="Color.Error">
            No se encontró el Warframe solicitado.
        </MudText>
    }
    else
    {
        <MudPaper Class="p-6">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <img src="@GetImageUrl(warframe.ImageName)"
                         alt="@warframe.Name"
                         style="width:100%;border-radius:8px;" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h4" Color="Color.Primary">@warframe.Name</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2 mb-3">@warframe.Description</MudText>

                    <MudText Typo="Typo.subtitle2">Estadísticas</MudText>
                    <MudList Dense="true">
                        <MudListItem>Vida: @warframe.Health</MudListItem>
                        <MudListItem>Armadura: @warframe.Armor</MudListItem>
                    </MudList>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Componentes</MudText>

            @if (components == null || components.Count == 0)
            {
                <MudText Typo="Typo.caption">Sin componentes registrados.</MudText>
            }
            else
            {
                @foreach (var c in components)
                {
                    <MudPaper Class="p-3 mb-3" Elevation="1">
                        <MudGrid>
                            <MudItem xs="12" md="4">
                                <img src="@GetImageUrl(c.ImageName)"
                                     alt="@c.Name"
                                     style="width:100%;border-radius:8px;" />
                            </MudItem>

                            <MudItem xs="12" md="8">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Primary">@c.Name</MudText>

                                    <!-- 🔹 Reliquias relacionadas -->
                                    @if (c.RelicLinks != null && c.RelicLinks.Count > 0)
                                    {
                                        <MudText Typo="Typo.caption"><b>Reliquias que lo dropean:</b></MudText>
                                        @foreach (var rel in c.RelicLinks)
                                        {
                                            <MudPaper Class="p-2 mb-1" Elevation="0">
                                                <MudText Typo="Typo.body2">
                                                    <MudLink Href="@($"/relics/{Uri.EscapeDataString(rel.UniqueName)}")">
                                                        @rel.Name
                                                    </MudLink>
                                                    — <i>@(rel.Vaulted ? "Vaulted" : "Disponible")</i>
                                                </MudText>
                                                <MudNumericField @bind-Value="rel.Quantity"
                                                                 Label="Cantidad"
                                                                 Min="0" Max="99"
                                                                 Immediate="true"
                                                                 Class="w-24 mt-1" />
                                            </MudPaper>
                                        }
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption">No hay reliquias registradas.</MudText>
                                    }

                                    <MudDivider Class="my-2" />

                                    <MudCheckBox @bind-Checked="c.Owned"
                                                 Label="Tengo este componente"
                                                 Color="Color.Success" />

                                    <MudNumericField @bind-Value="c.Quantity"
                                                     Label="Cantidad"
                                                     Min="0" Max="99"
                                                     Immediate="true"
                                                     Class="w-24" />

                                    @if (c.Drops != null && c.Drops.Count > 0)
                                    {
                                        <MudText Typo="Typo.caption" Class="mt-2"><b>Ubicaciones:</b></MudText>
                                        <MudList Dense="true">
                                            @foreach (var drop in c.Drops)
                                            {
                                                var linkedRelic = c.RelicLinks?.FirstOrDefault(r =>
                                                    drop.Location.Contains(r.Name, StringComparison.OrdinalIgnoreCase));

                                                <MudListItem>
                                                    <MudText Typo="Typo.body2">
                                                        <b>@drop.Location</b> (<i>@drop.Rarity</i>) — Prob: @drop.Chance.ToString("0.##")%

                                                        @if (linkedRelic != null)
                                                        {
                                                            <span style="margin-left:8px; font-weight:bold;
                                                                         color:@(linkedRelic.Vaulted ? "red" : "green")">
                                                                @(linkedRelic.Vaulted ? "Vaulted" : "Disponible")
                                                            </span>

                                                            <MudNumericField @bind-Value="linkedRelic.Quantity"
                                                                            Min="0" Max="99"
                                                                            HideSpinButtons="true"
                                                                            Class="ml-3 w-20"
                                                                            Label="Cant." />
                                                        }
                                                    </MudText>
                                                </MudListItem>
                                            }
                                        </MudList>
                                    }
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
            }
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public string? uniqueName { get; set; }

    private Warframe? warframe;
    private List<WarframeComponent>? components;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(uniqueName))
                return;

            var decodedName = Uri.UnescapeDataString(uniqueName);

            warframe = await Db.Warframes
                .AsNoTracking()
                .FirstOrDefaultAsync(w => w.UniqueName == decodedName);

            if (warframe != null && !string.IsNullOrWhiteSpace(warframe.ComponentsJson))
            {
                components = JsonSerializer.Deserialize<List<WarframeComponent>>(warframe.ComponentsJson);

                if (components != null)
                {
                    foreach (var comp in components)
                    {
                        if (comp.Drops == null) continue;

                        var relicNames = comp.Drops
                            .Where(d => !string.IsNullOrWhiteSpace(d.Location) && d.Location.Contains("Relic"))
                            .Select(d => d.Location)
                            .Distinct()
                            .ToList();

                        var relics = new List<Relic>();

                        foreach (var relicNameRaw in relicNames)
                        {
                            var cleanName = relicNameRaw
                                .Replace("Reliquia", "", StringComparison.OrdinalIgnoreCase)
                                .Replace("Relic", "", StringComparison.OrdinalIgnoreCase)
                                .Replace(" (Radiant)", "", StringComparison.OrdinalIgnoreCase)
                                .Replace(" (Flawless)", "", StringComparison.OrdinalIgnoreCase)
                                .Replace(" (Exceptional)", "", StringComparison.OrdinalIgnoreCase)
                                .Trim();

                            var core = cleanName.ToLower().Trim(); // ej: "axi i3"

                            // Busca coincidencia flexible en ambos idiomas
                            var found = await Db.Relics
                                .AsNoTracking()
                                .FirstOrDefaultAsync(r =>
                                    r.Name.ToLower().Contains(core) ||
                                    r.UniqueName.ToLower().Contains(core));


                            if (found != null)
                                relics.Add(found);
                        }

                        if (relics.Count > 0)
                        {
                            comp.RelicLinks = relics.Select(r => new RelicLink
                            {
                                Name = r.Name,
                                UniqueName = r.UniqueName,
                                Vaulted = r.Vaulted,
                                Quantity = 0
                            }).ToList();
                        }

                        Console.WriteLine($"Componente {comp.Name}: {relics.Count} reliquias encontradas.");
                        foreach (var r in relics)
                            Console.WriteLine($"   → {r.Name} | Vaulted: {r.Vaulted}");
                    }

                    Console.WriteLine($"Total componentes con reliquias: {components.Count(c => c.RelicLinks?.Count > 0)}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando detalle de Warframe: {ex.Message}");
        }

        loading = false;
    }

    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "_content/MudBlazor/images/placeholder.png"
            : $"https://cdn.warframestat.us/img/{imageName}";
}
