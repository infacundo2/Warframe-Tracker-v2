@page "/warframes/{uniqueName}"
@using Microsoft.EntityFrameworkCore
@using WarframeInventory.Models
@using System.Security.Claims
@using System.Text.Json
@inject WarframeInventory.Data.ApplicationDbContext Db
@inject AuthenticationStateProvider AuthState
@inject UserGoalService GoalService
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (warframe == null)
    {
        <MudText Typo="Typo.h6" Color="Color.Error">
            No se encontró el Warframe solicitado.
        </MudText>
    }
    else
    {
        <MudPaper Class="p-6">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <img src="@GetImageUrl(warframe.ImageName)"
                         alt="@warframe.Name"
                         style="width:100%;border-radius:8px;" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h4" Color="Color.Primary">@warframe.Name</MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="@(goalSelected ? Color.Secondary : Color.Primary)"
                               StartIcon="@Icons.Material.Filled.TrackChanges"
                               Disabled="@string.IsNullOrWhiteSpace(userId)"
                               OnClick="ToggleGoalAsync"
                               Class="mt-2">
                        @(goalSelected ? "Quitar de objetivos" : "Añadir a objetivos")
                    </MudButton>
                    <MudText Typo="Typo.body1" Class="mt-2 mb-3">@warframe.Description</MudText>

                    <MudText Typo="Typo.subtitle2">Estadísticas</MudText>
                    <MudList Dense="true">
                        <MudListItem>Vida: @warframe.Health</MudListItem>
                        <MudListItem>Armadura: @warframe.Armor</MudListItem>
                    </MudList>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Componentes</MudText>

            @if (components == null || components.Count == 0)
            {
                <MudText Typo="Typo.caption">Sin componentes registrados.</MudText>
            }
            else
            {
                @if (components.Any(c => c.RelicLinks?.Count > 0))
                {
                    <MudSelect T="string"
                               Label="Filtrar reliquias"
                               @bind-Value="relicAvailabilityFilter"
                               Variant="Variant.Outlined"
                               Class="catalog-filter mb-3">
                        <MudSelectItem T="string" Value="@("all")">Todas</MudSelectItem>
                        <MudSelectItem T="string" Value="@("available")">Solo disponibles</MudSelectItem>
                        <MudSelectItem T="string" Value="@("vaulted")">Solo vaulted</MudSelectItem>
                    </MudSelect>
                }

                @foreach (var c in components)
                {
                    <MudPaper Class="p-3 mb-3" Elevation="1">
                        <MudGrid>
                            <MudItem xs="12" md="4">
                                <img src="@GetImageUrl(c.ImageName)" alt="@c.Name" style="width:100%;border-radius:8px;" />
                            </MudItem>

                            <MudItem xs="12" md="8">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Primary">
                                        @c.Name
                                        @if (c.ItemCount > 1)
                                        {
                                            <span class="component-required"> · requiere @c.ItemCount</span>
                                        }
                                    </MudText>

                                    <MudStack Direction="Row" AlignItems="@AlignItems.Center" Spacing="2">
                                        <MudCheckBox T="bool"
                                                    Checked="@c.Owned"
                                                    Label="Tengo este componente"
                                                    Color="Color.Success"
                                                    CheckedChanged="@(async (bool v) => { c.Owned = v; await UpdateComponentAsync(c); })" />

                                        <MudNumericField T="int"
                                                        Value="@c.Quantity"
                                                        Label="Cantidad"
                                                        Min="0"
                                                        Max="999999"
                                                        Immediate="true"
                                                        Class="w-24"
                                                        ValueChanged="@(async (int v) => { c.Quantity = v; await UpdateComponentAsync(c); })" />
                                    </MudStack>

                                    <MudDivider Class="my-2" />

                                    @if (c.RelicLinks != null && c.RelicLinks.Count > 0)
                                    {
                                        <MudText Typo="Typo.caption"><b>Reliquias que lo dropean:</b></MudText>
                                        var filteredRelics = FilterRelics(c.RelicLinks).ToList();
                                        @if (filteredRelics.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Warning">
                                                Este componente no tiene reliquias que coincidan con el filtro.
                                            </MudText>
                                        }
                                        @foreach (var rel in filteredRelics)
                                        {
                                            <MudPaper Class="p-2 mb-1" Elevation="0">
                                                <MudText Typo="Typo.body2">
                                                    <MudLink Href="@($"/relics/{Uri.EscapeDataString(rel.UniqueName)}")">
                                                        @rel.Name
                                                    </MudLink>
                                                    — <i style="color:@(rel.Vaulted ? "red" : "green")">
                                                        @(rel.Vaulted ? "Vaulted" : "Disponible")
                                                      </i>
                                                </MudText>
                                                <div class="relic-inventory-summary">
                                                    <span class="relic-total">Total @rel.TotalQuantity</span>
                                                    <span title="Intactas">I <b>@rel.IntactQuantity</b></span>
                                                    <span title="Excepcionales">E <b>@rel.ExceptionalQuantity</b></span>
                                                    <span title="Perfectas">P <b>@rel.FlawlessQuantity</b></span>
                                                    <span title="Radiantes">R <b>@rel.RadiantQuantity</b></span>
                                                </div>
                                            </MudPaper>
                                        }
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption">No hay reliquias registradas.</MudText>
                                    }
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
            }
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public string? uniqueName { get; set; }

    private Warframe? warframe;
    private List<WarframeComponent>? components;
    private string userId = "";
    private bool loading = true;
    private string relicAvailabilityFilter = "all";
    private bool goalSelected;

    private IEnumerable<RelicLink> FilterRelics(IEnumerable<RelicLink> relics)
        => relicAvailabilityFilter switch
        {
            "available" => relics.Where(r => !r.Vaulted),
            "vaulted" => relics.Where(r => r.Vaulted),
            _ => relics
        };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("============== DEBUG WARFRAME DETAIL ==============");

            // 🔹 Usuario autenticado
            var authState = await AuthState.GetAuthenticationStateAsync();
            var user = authState.User;
            userId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
            Console.WriteLine($"👤 Usuario autenticado: {user.Identity?.Name} ({userId})");

            if (string.IsNullOrWhiteSpace(uniqueName))
                return;

            var decodedName = Uri.UnescapeDataString(uniqueName);
            Console.WriteLine($"🔹 Cargando Warframe: {decodedName}");

            // 🔹 Warframe base
            warframe = await Db.Warframes
                .AsNoTracking()
                .FirstOrDefaultAsync(w => w.UniqueName == decodedName);

            if (warframe == null)
            {
                Console.WriteLine("❌ Warframe no encontrado");
                loading = false;
                return;
            }

            if (!string.IsNullOrWhiteSpace(userId))
                goalSelected = await GoalService.IsGoalAsync(
                    userId, "warframe", warframe.UniqueName);

            // 🔹 Componentes
            if (!string.IsNullOrWhiteSpace(warframe.ComponentsJson))
            {
                components = JsonSerializer.Deserialize<List<WarframeComponent>>(warframe.ComponentsJson);

                if (components != null)
                {
                    Console.WriteLine($"📦 {components.Count} componentes encontrados");

                    // 🔹 Datos del usuario
                    var userComps = await Db.UserComponents
                        .Where(x => x.UserId == userId && x.ParentUnique == warframe.UniqueName)
                        .ToListAsync();

                    Console.WriteLine($"📊 UserComponents cargados: {userComps.Count}");

                    foreach (var comp in components)
                    {
                        var match = userComps.FirstOrDefault(x => x.ComponentName == comp.Name);
                        if (match != null)
                        {
                            comp.Owned = match.Owned;
                            comp.Quantity = match.Quantity;
                        }

                        await LoadRelicLinksAsync(comp);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error cargando detalle de Warframe: {ex}");
        }

        loading = false;
    }

    private async Task LoadRelicLinksAsync(WarframeComponent comp)
    {
        try
        {
            if (comp.Drops == null) return;

            var relicNames = comp.Drops
                .Where(d => !string.IsNullOrWhiteSpace(d.Location) && d.Location.Contains("Relic"))
                .Select(d => d.Location)
                .Distinct()
                .ToList();

            var links = new List<RelicLink>();

            foreach (var relicNameRaw in relicNames)
            {
                var cleanName = relicNameRaw
                    .Replace("Reliquia", "", StringComparison.OrdinalIgnoreCase)
                    .Replace("Relic", "", StringComparison.OrdinalIgnoreCase)
                    .Replace(" (Radiant)", "", StringComparison.OrdinalIgnoreCase)
                    .Replace(" (Flawless)", "", StringComparison.OrdinalIgnoreCase)
                    .Replace(" (Exceptional)", "", StringComparison.OrdinalIgnoreCase)
                    .Replace(" (Intact)", "", StringComparison.OrdinalIgnoreCase)
                    .Replace(" (Radiante)", "", StringComparison.OrdinalIgnoreCase)
                    .Replace(" (Perfecta)", "", StringComparison.OrdinalIgnoreCase)
                    .Replace(" (Excepcional)", "", StringComparison.OrdinalIgnoreCase)
                    .Replace(" (Intacta)", "", StringComparison.OrdinalIgnoreCase)
                    .Trim();

                var core = cleanName.ToLowerInvariant();
                var expectedSpanishName = $"reliquia {core}";
                var expectedEnglishName = $"{core} relic";

                var variants = await Db.Relics
                    .AsNoTracking()
                    .Where(r => r.Name.ToLower() == core
                                || r.Name.ToLower() == expectedSpanishName
                                || r.Name.ToLower() == expectedEnglishName)
                    .ToListAsync();

                if (variants.Count == 0)
                    continue;

                var variantKeys = variants.Select(r => r.UniqueName).ToList();
                var ownedByUnique = string.IsNullOrWhiteSpace(userId)
                    ? new Dictionary<string, int>()
                    : await Db.UserRelics.AsNoTracking()
                        .Where(x => x.UserId == userId && variantKeys.Contains(x.RelicUnique))
                        .ToDictionaryAsync(x => x.RelicUnique, x => x.Quantity);

                int QuantityFor(string refinement) => variants
                    .Where(v => GetRefinementName(v.UniqueName) == refinement)
                    .Sum(v => ownedByUnique.GetValueOrDefault(v.UniqueName));

                var intact = variants.FirstOrDefault(v => GetRefinementName(v.UniqueName) == "Intacta")
                             ?? variants[0];
                links.Add(new RelicLink
                {
                    Name = variants[0].Name,
                    UniqueName = intact.UniqueName,
                    Vaulted = variants.All(v => v.Vaulted),
                    IntactQuantity = QuantityFor("Intacta"),
                    ExceptionalQuantity = QuantityFor("Excepcional"),
                    FlawlessQuantity = QuantityFor("Perfecta"),
                    RadiantQuantity = QuantityFor("Radiante")
                });
            }

            comp.RelicLinks = links
                .GroupBy(x => x.Name)
                .Select(x => x.First())
                .ToList();

            Console.WriteLine($"🧩 {comp.Name}: {links.Count} reliquias asociadas");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠️ Error procesando reliquias de {comp.Name}: {ex.Message}");
        }
    }

    private async Task UpdateComponentAsync(WarframeComponent comp)
    {
        try
        {
            Console.WriteLine($"🟡 UpdateComponentAsync → {comp.Name} Owned={comp.Owned}, Qty={comp.Quantity}");

            if (string.IsNullOrWhiteSpace(userId))
            {
                Console.WriteLine("❌ Usuario no autenticado, no se guardará.");
                return;
            }

            var existing = await Db.UserComponents
                .FirstOrDefaultAsync(x =>
                    x.UserId == userId &&
                    x.ParentUnique == warframe!.UniqueName &&
                    x.ComponentName == comp.Name);

            if (existing == null)
            {
                existing = new UserComponent
                {
                    UserId = userId,
                    ParentUnique = warframe!.UniqueName,
                    ComponentName = comp.Name,
                    Owned = comp.Owned,
                    Quantity = comp.Quantity
                };
                Db.UserComponents.Add(existing);
                Console.WriteLine("➕ Nuevo componente creado.");
            }
            else
            {
                existing.Owned = comp.Owned;
                existing.Quantity = comp.Quantity;
                Console.WriteLine("🔁 Componente existente actualizado.");
            }

            var result = await Db.SaveChangesAsync();
            Console.WriteLine($"✅ Guardado OK ({result} filas afectadas)");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error guardando componente {comp.Name}: {ex.Message}");
        }
    }

    private async Task ToggleGoalAsync()
    {
        if (warframe is null || string.IsNullOrWhiteSpace(userId))
            return;

        goalSelected = await GoalService.ToggleAsync(
            userId, "warframe", warframe.UniqueName, warframe.Name);
    }

    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "_content/MudBlazor/images/placeholder.png"
            : $"https://cdn.warframestat.us/img/{imageName}";

    private static string GetRefinementName(string uniqueName)
        => uniqueName.EndsWith("Silver", StringComparison.OrdinalIgnoreCase) ? "Excepcional" :
           uniqueName.EndsWith("Gold", StringComparison.OrdinalIgnoreCase) ? "Perfecta" :
           uniqueName.EndsWith("Platinum", StringComparison.OrdinalIgnoreCase) ? "Radiante" :
           "Intacta";
}
