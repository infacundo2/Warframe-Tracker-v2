@page "/mods"

@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject WarframeInventory.Data.ApplicationDbContext Db
@inject AuthenticationStateProvider AuthState
@using WarframeInventory.Models
@using MudBlazor

<MudContainer  MaxWidth="MaxWidth.False"
              Class="px-6 py-4 min-h-[80vh] flex flex-col justify-start">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h4" Color="Color.Primary">Mods</MudText>

        @if (duplicateMods.Count > 0)
        {
            <MudExpansionPanels Class="duplicate-mods">
                <MudExpansionPanel Text="@($"{duplicateMods.Sum(x => x.ExtraCopies)} copias duplicadas · ~{duplicateMods.Sum(x => x.EstimatedEndo):N0} Endo")">
                    <MudText Typo="Typo.caption">
                        Estimación para copias sin rango. Revisa el valor final antes de disolver en el juego.
                    </MudText>
                    <div class="duplicate-mod-grid">
                        @foreach (var duplicate in duplicateMods.Take(30))
                        {
                            <a href="@($"/mods/{Uri.EscapeDataString(duplicate.UniqueName)}")">
                                <b>@duplicate.Name</b><span>@duplicate.ExtraCopies extras</span>
                                <small>~@duplicate.EstimatedEndo Endo</small>
                            </a>
                        }
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        <!-- 🔍 Búsqueda -->
        <MudTextField @bind-Value="searchTerm"
                      Placeholder="Buscar mod..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="catalog-toolbar"
                      Immediate="true"
                      DebounceInterval="350"
                      OnDebounceIntervalElapsed="RefreshAsync" />

        <div class="mod-filters">
            <MudSelect T="string" Label="Compatibilidad" Value="@compatibilityFilter"
                       ValueChanged="@((string value) => ChangeFilterAsync("compat", value))"
                       Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("all")">Todas</MudSelectItem>
                @foreach (var value in compatibilities) { <MudSelectItem T="string" Value="@value">@value</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" Label="Polaridad" Value="@polarityFilter"
                       ValueChanged="@((string value) => ChangeFilterAsync("polarity", value))"
                       Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("all")">Todas</MudSelectItem>
                @foreach (var value in polarities) { <MudSelectItem T="string" Value="@value">@value</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" Label="Rareza" Value="@rarityFilter"
                       ValueChanged="@((string value) => ChangeFilterAsync("rarity", value))"
                       Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("all")">Todas</MudSelectItem>
                @foreach (var value in rarities) { <MudSelectItem T="string" Value="@value">@value</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" Label="Colección" Value="@collectionFilter"
                       ValueChanged="@((string value) => ChangeFilterAsync("collection", value))"
                       Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("all")">Todas</MudSelectItem>
                <MudSelectItem T="string" Value="@("primed")">Primed</MudSelectItem>
                <MudSelectItem T="string" Value="@("augment")">Augment</MudSelectItem>
                <MudSelectItem T="string" Value="@("galvanized")">Galvanized</MudSelectItem>
                <MudSelectItem T="string" Value="@("archon")">Archon</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" Label="Inventario" Value="@ownedFilter"
                       ValueChanged="@((string value) => ChangeFilterAsync("owned", value))"
                       Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("all")">Todos</MudSelectItem>
                <MudSelectItem T="string" Value="@("owned")">Poseídos</MudSelectItem>
                <MudSelectItem T="string" Value="@("missing")">Faltantes</MudSelectItem>
            </MudSelect>
        </div>

        @if (loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mx-auto my-8" />
        }
        else if (pagedMods.Count == 0)
        {
            <MudText Typo="Typo.body1" Align="Align.Center">No se encontraron mods.</MudText>
        }
        else
        {
            <MudGrid GutterSize="3">
                @foreach (var m in pagedMods)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Class="mb-4">
                            <img src="@GetImageUrl(m.ImageName)"
                                 loading="lazy"
                                 decoding="async" width="360" height="210" class="catalog-image"
                                 alt="@m.Name"
                                 />
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1" Color="Color.Primary">@m.Name</MudText>
                                <MudText Typo="Typo.caption">@m.Polarity • @m.Rarity</MudText>
                                @if (m.Quantity > 1)
                                {
                                    <MudChip Size="Size.Small" Color="Color.Warning">@m.Quantity copias</MudChip>
                                }
                                <MudText Typo="Typo.body2" Class="line-clamp-3 mt-1">@m.Description</MudText>
                            </MudCardContent>
                            <MudCardActions>
                                <MudCheckBox T="bool"
                                             Checked="@m.IsOwned"
                                             Label="Lo tengo"
                                             Color="Color.Success"
                                             Disabled="@string.IsNullOrEmpty(userId)"
                                             CheckedChanged="@(async (bool v) => await ToggleOwnedAsync(m, v))" />
                                <MudSpacer />
                                <MudButton Variant="Variant.Text" Color="Color.Primary"
                                           Href="@($"/mods/{Uri.EscapeDataString(m.UniqueName)}")">
                                    Ver detalle
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>

            <div class="d-flex justify-center mt-6">
                <MudPagination Selected="@currentPage"
                               Count="@totalPages"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary"
                               Size="Size.Medium" />
            </div>
        }
    </MudStack>
</MudContainer>
