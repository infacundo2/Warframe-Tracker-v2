@page "/mods"
@using Microsoft.EntityFrameworkCore
@inject WarframeInventory.Data.ApplicationDbContext Db
@using WarframeInventory.Models

<MudText Typo="Typo.h4" Class="mb-4">Mods</MudText>

<MudPaper Class="p-4">
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (mods == null || mods.Count == 0)
    {
        <MudText>No se encontraron mods.</MudText>
    }
    else
    {
        <MudGrid>
            @foreach (var m in mods)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Class="mb-4">
                        <img src="@GetImageUrl(m.ImageName)"
                             alt="@m.Name"
                             style="width:100%;height:200px;object-fit:contain;background-color:#111;border-radius:8px;" />
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary">@m.Name</MudText>
                            <MudText Typo="Typo.caption">@m.Polarity • @m.Rarity</MudText>
                            @if (!string.IsNullOrWhiteSpace(m.Description))
                            {
                                <MudText Typo="Typo.body2" Class="mt-1">
                                    @((m.Description.Length > 100 ? m.Description[..100] + "..." : m.Description))
                                </MudText>
                            }
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                       Href="@($"/mods/{Uri.EscapeDataString(m.UniqueName)}")">
                                Ver detalle
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>

@code {
    private List<Mod>? mods;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            mods = await Db.Mods
                .OrderBy(m => m.Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando mods: {ex.Message}");
            mods = new();
        }

        loading = false;
    }

    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "_content/MudBlazor/images/placeholder.png"
            : $"https://cdn.warframestat.us/img/{imageName}";
}
