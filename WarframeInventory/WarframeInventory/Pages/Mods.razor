@page "/mods"
@inject WarframeInventory.Services.WarframeApiService Api

<MudText Typo="Typo.h4" Class="mb-4">Mods</MudText>

<MudPaper Class="p-4">
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (mods?.Count == 0)
    {
        <MudText>No se encontraron Mods.</MudText>
    }
    else
    {
        <MudGrid>
            @foreach (var m in mods)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Class="mb-4">
                        <img src="@GetImageUrl(m.ImageName)" alt="@m.Name" style="width:100%;height:200px;object-fit:cover;" />
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1">@m.Name</MudText>
                            <MudText Typo="Typo.caption">
                                @if (!string.IsNullOrWhiteSpace(m.CompatName))
                                {
                                    @($"Compat: {m.CompatName} · ")
                                }
                                @($"Pol: {m.Polarity ?? "-"} · Rareza: {m.Rarity ?? "-"}")
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(m.Description))
                            {
                                <MudText Typo="Typo.body2">@m.Description</MudText>
                            }
                        </MudCardContent>
                        <MudCardActions>
                            <MudCheckBox T="bool" @bind-Checked="m.Owned" Label="Lo tengo" Color="Color.Success" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>

@code {
    private List<WarframeInventory.Models.Mod>? mods;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try { mods = await Api.GetModsAsync(); }
        catch { mods = new(); }
        loading = false;
    }

    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "_content/MudBlazor/images/placeholder.png"
            : $"https://cdn.warframestat.us/img/{imageName}";
}
