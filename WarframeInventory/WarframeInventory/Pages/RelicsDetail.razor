@page "/relics/{uniqueName}"
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Security.Claims
@inject WarframeInventory.Data.ApplicationDbContext Db
@inject AuthenticationStateProvider AuthState
@using WarframeInventory.Models
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (relic == null)
    {
        <MudText Typo="Typo.h6" Color="Color.Error">No se encontró la reliquia solicitada.</MudText>
    }
    else
    {
        <MudPaper Class="p-6">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <img src="@GetImageUrl(relic.ImageName)" alt="@relic.Name"
                         style="width:100%;border-radius:8px;" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h4" Color="Color.Primary">@relic.Name</MudText>
                    <MudText Typo="Typo.subtitle2">@relic.Category</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2 mb-3">
                        @(relic.Vaulted ? "Vaulted" : "Disponible") — @(relic.Tradable ? "Intercambiable" : "No intercambiable")
                    </MudText>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <!-- ==================== CANTIDADES DEL USUARIO ==================== -->
            <MudText Typo="Typo.h6" Class="mb-2">Tus cantidades</MudText>

            @if (variantCounts == null || variantCounts.Count == 0)
            {
                <MudText Typo="Typo.caption">No se ha cargado información del usuario.</MudText>
            }
            else
            {
                <MudTable Items="variantCounts" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Tipo</MudTh>
                        <MudTh>Cantidad</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Tipo">
                            <div style="display:flex;align-items:center;gap:10px;">
                                <img src="@GetImageUrl(@context.ImageName)"
                                    style="width:32px;height:32px;border-radius:4px;" />
                                <span>@context.DisplayName</span>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Cantidad">
                            <MudNumericField T="int"
                                            Value="@context.Quantity"
                                            ValueChanged="@(async (int v) => await UpdateQuantityAsync(context, v))"
                                            Min="0" Max="99"
                                            Immediate="true"
                                            Class="w-20"
                                            Style="@($"color:{(context.Quantity > 0 ? "limegreen" : "gray")}")" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }



            <MudDivider Class="my-4" />

            <!-- ==================== RECOMPENSAS ==================== -->
            <MudText Typo="Typo.h6" Class="mb-2">Recompensas al abrir</MudText>

            @if (rewards == null || rewards.Count == 0)
            {
                <MudText Typo="Typo.caption">Sin recompensas registradas.</MudText>
            }
            else
            {
                <MudTable Items="rewards" Dense="true">
                    <HeaderContent>
                        <MudTh>Ítem</MudTh>
                        <MudTh>Rareza</MudTh>
                        <MudTh>Probabilidad</MudTh>
                        <MudTh>Warframe Market</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Ítem">@context.ItemName</MudTd>
                        <MudTd DataLabel="Rareza">@context.Rarity</MudTd>
                        <MudTd DataLabel="Probabilidad">@context.Chance.ToString("0.##")%</MudTd>
                        <MudTd DataLabel="Warframe Market">
                            @if (!string.IsNullOrEmpty(context.MarketUrl))
                            {
                                <MudLink Href="@context.MarketUrl" Target="_blank">Ver en Warframe Market</MudLink>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption">N/A</MudText>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }

            <!-- ==================== UBICACIONES ==================== -->
            @if (!relic.Vaulted)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.h6" Class="mb-2">Dónde conseguir esta reliquia</MudText>

                @if (dropLocations != null && dropLocations.Count > 0)
                {
                    <MudTable Items="dropLocations" Dense="true">
                        <HeaderContent>
                            <MudTh>Ubicación</MudTh>
                            <MudTh>Tipo</MudTh>
                            <MudTh>Rotación</MudTh>
                            <MudTh>Rareza</MudTh>
                            <MudTh>Probabilidad</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Ubicación">@context.Location</MudTd>
                            <MudTd DataLabel="Tipo">@context.Type</MudTd>
                            <MudTd DataLabel="Rotación">@context.Rotation</MudTd>
                            <MudTd DataLabel="Rareza">@context.Rarity</MudTd>
                            <MudTd DataLabel="Probabilidad">@context.Chance.ToString("0.####")%</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.caption">No hay datos de dónde se consigue esta reliquia.</MudText>
                }
            }
            else
            {
                <MudText Typo="Typo.caption" Color="Color.Error">
                    Esta reliquia está Vaulted y ya no se puede obtener en misiones.
                </MudText>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public string? uniqueName { get; set; }

    private Relic? relic;
    private List<RelicReward>? rewards;
    private List<RelicDrop>? dropLocations;
    private List<RelicVariant> variantCounts = new();
    private bool loading = true;
    private string userId = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(uniqueName))
                return;

            var decoded = Uri.UnescapeDataString(uniqueName);

            Console.WriteLine($"🔍 Cargando detalle de reliquia: {decoded}");

            var relicCheck = await Db.Relics.AsNoTracking()
                .FirstOrDefaultAsync(r => r.UniqueName == decoded);
            if (relicCheck == null)
            {
                Console.WriteLine("❌ No se encontró ninguna reliquia con ese UniqueName en la base de datos.");
            }
            else
            {
                Console.WriteLine($"✅ Reliquia encontrada: {relicCheck.Name} ({relicCheck.UniqueName})");
            }


            // 🔹 Usuario autenticado
            var auth = await AuthState.GetAuthenticationStateAsync();
            userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

            relic = await Db.Relics.AsNoTracking().FirstOrDefaultAsync(r => r.UniqueName == decoded);
            if (relic == null)
                return;

            // 🔹 Obtener variantes (Intacta, Excepcional, Flawless, Radiante)
            var variants = await Db.Relics
                .Where(r => r.Name == relic.Name)
                .OrderBy(r => r.UniqueName)
                .ToListAsync();

            Console.WriteLine($"🔹 Variantes encontradas para {relic.Name}: {variants.Count}");
                foreach (var v in variants)
                    Console.WriteLine($"   - {v.UniqueName}");


            var userRelics = await Db.UserRelics
                .Where(u => u.UserId == userId)
                .ToListAsync();

            Console.WriteLine($"👤 User {userId} tiene {userRelics.Count} registros en UserRelics");
                foreach (var ur in userRelics)
                    Console.WriteLine($"   -> {ur.RelicUnique} = {ur.Quantity}");


            variantCounts = variants.Select(v => new RelicVariant
            {
                UniqueName = v.UniqueName,
                DisplayName = v.UniqueName.Contains("EBronze") ? "Intacta" :
                            v.UniqueName.Contains("ESilver") ? "Excepcional" :
                            v.UniqueName.Contains("EGold") ? "Perfecta" :
                            v.UniqueName.Contains("EPlatinum") ? "Radiante" : "Desconocida",
                ImageName = v.ImageName,
                Quantity = userRelics.FirstOrDefault(u => u.RelicUnique == v.UniqueName)?.Quantity ?? 0
            })
            .OrderBy(v => v.DisplayName switch
            {
                "Intacta" => 1,
                "Excepcional" => 2,
                "Perfecta" => 3,
                "Radiante" => 4,
                _ => 99
            })
            .ToList();


            Console.WriteLine($"📦 Renderizando {variantCounts.Count} variantes en la vista");
            foreach (var v in variantCounts)
                Console.WriteLine($"   - {v.DisplayName}: {v.Quantity}");

            await InvokeAsync(StateHasChanged);


            // --- RECOMPENSAS ---
            if (!string.IsNullOrWhiteSpace(relic.RewardsJson))
            {
                try
                {
                    var doc = JsonDocument.Parse(relic.RewardsJson);
                    rewards = new();

                    foreach (var el in doc.RootElement.EnumerateArray())
                    {
                        string itemName = "";
                        string rarity = "";
                        double chance = 0;
                        string? marketUrl = null;

                        if (el.TryGetProperty("rarity", out var rar)) rarity = rar.GetString() ?? "";
                        if (el.TryGetProperty("chance", out var c)) chance = c.GetDouble();

                        if (el.TryGetProperty("item", out var itemObj))
                        {
                            itemName = itemObj.GetProperty("name").GetString() ?? "";
                            if (itemObj.TryGetProperty("warframeMarket", out var wm) &&
                                wm.TryGetProperty("urlName", out var url))
                                marketUrl = $"https://warframe.market/items/{url.GetString()}";
                        }

                        rewards.Add(new RelicReward
                        {
                            ItemName = itemName,
                            Rarity = rarity,
                            Chance = chance,
                            MarketUrl = marketUrl
                        });
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error deserializando recompensas: {ex.Message}");
                }
            }

            // --- DROPS ---
            if (!string.IsNullOrWhiteSpace(relic.DropsJson))
            {
                try
                {
                    dropLocations = JsonSerializer.Deserialize<List<RelicDrop>>(relic.DropsJson,
                        new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error deserializando DropsJson: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando detalle de reliquia: {ex.Message}");
        }

        loading = false;
    }

    private async Task UpdateQuantityAsync(RelicVariant variant, int count)
    {
        try
        {
            var existing = await Db.UserRelics
                .FirstOrDefaultAsync(u => u.UserId == userId && u.RelicUnique == variant.UniqueName);

            if (existing == null)
            {
                existing = new UserRelic
                {
                    UserId = userId,
                    RelicUnique = variant.UniqueName,
                    Quantity = count
                };
                Db.UserRelics.Add(existing);
            }
            else
            {
                existing.Quantity = count;
            }

            await Db.SaveChangesAsync();
            variant.Quantity = count;
            Console.WriteLine($"✅ {variant.DisplayName} ({variant.UniqueName}) → {count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error actualizando cantidad de reliquia: {ex.Message}");
        }
    }

    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "_content/MudBlazor/images/placeholder.png"
            : $"https://cdn.warframestat.us/img/{imageName}";

    // ==== Clases auxiliares ====
    private class RelicReward
    {
        public string ItemName { get; set; } = "";
        public string Rarity { get; set; } = "";
        public double Chance { get; set; }
        public string? MarketUrl { get; set; }
    }

    private class RelicDrop
    {
        [JsonPropertyName("location")] public string Location { get; set; } = "";
        [JsonPropertyName("type")] public string Type { get; set; } = "";
        [JsonPropertyName("rotation")] public string? Rotation { get; set; }
        [JsonPropertyName("rarity")] public string? Rarity { get; set; }
        [JsonPropertyName("chance")] public double Chance { get; set; }
    }

    private class RelicVariant
    {
        public string UniqueName { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string ImageName { get; set; } = "";
        public int Quantity { get; set; }
    }
}
