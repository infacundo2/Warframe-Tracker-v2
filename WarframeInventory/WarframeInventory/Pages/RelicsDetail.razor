@page "/relics/{uniqueName}"
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Security.Claims
@inject WarframeInventory.Data.ApplicationDbContext Db
@inject AuthenticationStateProvider AuthState
@using WarframeInventory.Models
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    @if (loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (relic == null)
    {
        <MudText Typo="Typo.h6" Color="Color.Error">No se encontró la reliquia solicitada.</MudText>
    }
    else
    {
        <MudPaper Class="p-6">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <img src="@GetImageUrl(relic.ImageName)" alt="@relic.Name"
                         style="width:100%;border-radius:8px;" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h4" Color="Color.Primary">@relic.Name</MudText>
                    <MudText Typo="Typo.subtitle2">@relic.Category</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2 mb-3">
                        @(relic.Vaulted ? "Vaulted" : "Disponible") — @(relic.Tradable ? "Intercambiable" : "No intercambiable")
                    </MudText>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <!-- ==================== CANTIDADES DEL USUARIO ==================== -->
            <MudText Typo="Typo.h6" Class="mb-2">Tus cantidades</MudText>

            @if (variantCounts == null || variantCounts.Count == 0)
            {
                <MudText Typo="Typo.caption">No se ha cargado información del usuario.</MudText>
            }
            else
            {
                <MudTable Items="variantCounts" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Tipo</MudTh>
                        <MudTh>Cantidad</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Tipo">
                            <div style="display:flex;align-items:center;gap:10px;">
                                <img src="@GetImageUrl(@context.ImageName)"
                                    style="width:32px;height:32px;border-radius:4px;" />
                                <span>@context.DisplayName</span>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Cantidad">
                            <MudNumericField T="int"
                                            Value="@context.Quantity"
                                            ValueChanged="@(async (int v) => await UpdateQuantityAsync(context, v))"
                                            Min="0" Max="99"
                                            Immediate="true"
                                            Disabled="@string.IsNullOrEmpty(userId)"
                                            Class="w-20"
                                            Style="@($"color:{(context.Quantity > 0 ? "limegreen" : "gray")}")" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }



            <MudDivider Class="my-4" />

            <!-- ==================== RECOMPENSAS ==================== -->
            <div class="detail-section-heading">
                <MudText Typo="Typo.h6">Recompensas al abrir</MudText>
                <MudButton Href="@($"/relics/{Uri.EscapeDataString(relic.UniqueName)}/laboratorio")"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Science">
                    Abrir laboratorio
                </MudButton>
            </div>

            <MudSelect T="string"
                       Label="Estado de refinamiento"
                       @bind-Value="selectedRefinement"
                       Variant="Variant.Outlined"
                       Class="catalog-filter mb-2">
                <MudSelectItem T="string" Value="@("Intacta")">Intacta · 0 vestigios</MudSelectItem>
                <MudSelectItem T="string" Value="@("Excepcional")">Excepcional · 25 vestigios</MudSelectItem>
                <MudSelectItem T="string" Value="@("Perfecta")">Perfecta · 50 vestigios</MudSelectItem>
                <MudSelectItem T="string" Value="@("Radiante")">Radiante · 100 vestigios</MudSelectItem>
            </MudSelect>

            <MudText Typo="Typo.caption" Class="mb-3">
                Probabilidad individual para cada recompensa en estado <b>@selectedRefinement</b>.
            </MudText>

            @if (rewards == null || rewards.Count == 0)
            {
                <MudText Typo="Typo.caption">Sin recompensas registradas.</MudText>
            }
            else
            {
                <MudTable Items="rewards" Dense="true">
                    <HeaderContent>
                        <MudTh>Ítem</MudTh>
                        <MudTh>Rareza</MudTh>
                        <MudTh>Probabilidad (@selectedRefinement)</MudTh>
                        <MudTh>Warframe Market</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Ítem">@context.ItemName</MudTd>
                        <MudTd DataLabel="Rareza">@context.Rarity</MudTd>
                        <MudTd DataLabel="Probabilidad">
                            @{
                                var chance = context.GetChance(selectedRefinement);
                            }
                            @(chance.HasValue ? $"{chance.Value:0.00}%" : "Sin datos")
                        </MudTd>
                        <MudTd DataLabel="Warframe Market">
                            @if (!string.IsNullOrEmpty(context.MarketUrl))
                            {
                                <MudLink Href="@context.MarketUrl" Target="_blank"
                                         rel="noopener noreferrer">Ver en Warframe Market</MudLink>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption">N/A</MudText>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }

            <!-- ==================== UBICACIONES ==================== -->
            @if (!relic.Vaulted)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.h6" Class="mb-2">Dónde conseguir esta reliquia</MudText>

                @if (dropLocations != null && dropLocations.Count > 0)
                {
                    <MudTable Items="dropLocations" Dense="true">
                        <HeaderContent>
                            <MudTh>Ubicación</MudTh>
                            <MudTh>Tipo</MudTh>
                            <MudTh>Rotación</MudTh>
                            <MudTh>Rareza</MudTh>
                            <MudTh>Probabilidad</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Ubicación">@context.Location</MudTd>
                            <MudTd DataLabel="Tipo">@context.Type</MudTd>
                            <MudTd DataLabel="Rotación">@context.Rotation</MudTd>
                            <MudTd DataLabel="Rareza">@context.Rarity</MudTd>
                            <MudTd DataLabel="Probabilidad">@context.Chance.ToString("0.####")%</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.caption">No hay datos de dónde se consigue esta reliquia.</MudText>
                }
            }
            else
            {
                <MudText Typo="Typo.caption" Color="Color.Error">
                    Esta reliquia está Vaulted y ya no se puede obtener en misiones.
                </MudText>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public string? uniqueName { get; set; }

    private Relic? relic;
    private List<RelicRewardView>? rewards;
    private List<RelicDrop>? dropLocations;
    private List<RelicVariant> variantCounts = new();
    private bool loading = true;
    private string userId = "";
    private string selectedRefinement = "Intacta";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(uniqueName))
                return;

            var decoded = Uri.UnescapeDataString(uniqueName);

            // 🔹 Usuario autenticado
            var auth = await AuthState.GetAuthenticationStateAsync();
            userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

            relic = await Db.Relics.AsNoTracking().FirstOrDefaultAsync(r => r.UniqueName == decoded);
            if (relic == null)
                return;

            // 🔹 Obtener variantes (Intacta, Excepcional, Flawless, Radiante)
            var variants = await Db.Relics.AsNoTracking()
                .Where(r => r.Name == relic.Name)
                .OrderBy(r => r.UniqueName)
                .ToListAsync();

            var variantKeys = variants.Select(x => x.UniqueName).ToList();
            var userRelics = await Db.UserRelics.AsNoTracking()
                .Where(u => u.UserId == userId && variantKeys.Contains(u.RelicUnique))
                .ToListAsync();


            variantCounts = variants.Select(v => new RelicVariant
            {
                UniqueName = v.UniqueName,
                DisplayName = GetRefinementName(v.UniqueName),
                ImageName = v.ImageName ?? "",
                Quantity = userRelics.FirstOrDefault(u => u.RelicUnique == v.UniqueName)?.Quantity ?? 0
            })
            .OrderBy(v => v.DisplayName switch
            {
                "Intacta" => 1,
                "Excepcional" => 2,
                "Perfecta" => 3,
                "Radiante" => 4,
                _ => 99
            })
            .ToList();


            // --- RECOMPENSAS ---
            var rewardsByVariant = await Db.RelicRewards.AsNoTracking()
                .Where(x => variantKeys.Contains(x.RelicUnique))
                .ToListAsync();

            rewards = rewardsByVariant
                .GroupBy(x => x.ItemUnique)
                .Select(group =>
                {
                    var first = group.First();
                    var chances = group
                        .GroupBy(x => GetRefinementName(x.RelicUnique))
                        .ToDictionary(x => x.Key, x => x.First().Chance);

                    return new RelicRewardView
                    {
                        ItemName = first.ItemName,
                        Rarity = GetRewardRarity(chances.Values),
                        Chances = chances,
                        MarketUrl = string.IsNullOrEmpty(first.MarketUrlName)
                            ? null
                            : $"https://warframe.market/items/{first.MarketUrlName}"
                    };
                })
                .OrderByDescending(x => x.GetChance("Intacta") ?? 0)
                .ThenBy(x => x.ItemName)
                .ToList();

            // --- DROPS ---
            if (!string.IsNullOrWhiteSpace(relic.DropsJson))
            {
                try
                {
                    dropLocations = JsonSerializer.Deserialize<List<RelicDrop>>(relic.DropsJson,
                        new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error deserializando DropsJson: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando detalle de reliquia: {ex.Message}");
        }

        loading = false;
    }

    private async Task UpdateQuantityAsync(RelicVariant variant, int count)
    {
        try
        {
            if (string.IsNullOrEmpty(userId))
                return;
            var existing = await Db.UserRelics
                .FirstOrDefaultAsync(u => u.UserId == userId && u.RelicUnique == variant.UniqueName);

            if (existing == null)
            {
                existing = new UserRelic
                {
                    UserId = userId,
                    RelicUnique = variant.UniqueName,
                    Quantity = count
                };
                Db.UserRelics.Add(existing);
            }
            else
            {
                existing.Quantity = count;
            }

            await Db.SaveChangesAsync();
            variant.Quantity = count;
            Console.WriteLine($"✅ {variant.DisplayName} ({variant.UniqueName}) → {count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error actualizando cantidad de reliquia: {ex.Message}");
        }
    }

    private static string GetImageUrl(string? imageName)
        => string.IsNullOrWhiteSpace(imageName)
            ? "/images/item-placeholder.svg"
            : $"https://cdn.warframestat.us/img/{imageName}";

    private static string GetRefinementName(string uniqueName)
        => uniqueName.EndsWith("Silver", StringComparison.OrdinalIgnoreCase) ? "Excepcional" :
           uniqueName.EndsWith("Gold", StringComparison.OrdinalIgnoreCase) ? "Perfecta" :
           uniqueName.EndsWith("Platinum", StringComparison.OrdinalIgnoreCase) ? "Radiante" :
           "Intacta";

    private static string GetRewardRarity(IEnumerable<double> chances)
    {
        var values = chances.ToList();
        if (values.Count == 0)
            return "Desconocida";

        if (values.Max() > 20)
            return "Común";
        if (values.Min() <= 2.01)
            return "Rara";
        return "Poco común";
    }

    // ==== Clases auxiliares ====
    private class RelicRewardView
    {
        public string ItemName { get; set; } = "";
        public string Rarity { get; set; } = "";
        public Dictionary<string, double> Chances { get; set; } = new();
        public string? MarketUrl { get; set; }

        public double? GetChance(string refinement)
            => Chances.TryGetValue(refinement, out var chance) ? chance : null;
    }

    private class RelicDrop
    {
        [JsonPropertyName("location")] public string Location { get; set; } = "";
        [JsonPropertyName("type")] public string Type { get; set; } = "";
        [JsonPropertyName("rotation")] public string? Rotation { get; set; }
        [JsonPropertyName("rarity")] public string? Rarity { get; set; }
        [JsonPropertyName("chance")] public double Chance { get; set; }
    }

    private class RelicVariant
    {
        public string UniqueName { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string ImageName { get; set; } = "";
        public int Quantity { get; set; }
    }
}
