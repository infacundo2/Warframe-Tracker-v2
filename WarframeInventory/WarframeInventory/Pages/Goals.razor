@page "/goals"
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using WarframeInventory.Models
@inject IDbContextFactory<WarframeInventory.Data.ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthState
@inject UserGoalService GoalService
@inject GoalAnalysisService AnalysisService
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <section class="goal-hero orokin-panel">
        <div>
            <div class="eyebrow">PROTOCOLO DE ADQUISICIÓN // OBJETIVOS</div>
            <MudText Typo="Typo.h3" Class="page-title">Objetivos del operador</MudText>
            <MudText Typo="Typo.body1" Class="hero-copy">
                Define prioridades y convierte piezas pendientes en rutas de farmeo.
            </MudText>
        </div>
        @if (!string.IsNullOrWhiteSpace(userId))
        {
            <div class="goal-counter">
                <strong>@goals.Count(x => !x.IsCompleted)</strong>
                <span>objetivos activos</span>
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(userId) && goals.Count > 0)
    {
        <div class="goal-toolbar mt-4">
            <MudTextField @bind-Value="searchTerm" Placeholder="Buscar objetivo..."
                          Immediate="true" DebounceInterval="300"
                          OnDebounceIntervalElapsed="RefreshGoalsAsync"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            <MudSelect T="string" Value="@statusFilter" ValueChanged="ChangeStatusFilterAsync"
                       Label="Estado" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("active")">Activos</MudSelectItem>
                <MudSelectItem T="string" Value="@("completed")">Completados</MudSelectItem>
                <MudSelectItem T="string" Value="@("all")">Todos</MudSelectItem>
            </MudSelect>
        </div>
    }

    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-5" />
    }
    else if (string.IsNullOrWhiteSpace(userId))
    {
        <MudAlert Severity="Severity.Info" Class="mt-5">
            Inicia sesión para crear y sincronizar objetivos personales.
        </MudAlert>
    }
    else if (goals.Count == 0)
    {
        <MudPaper Class="goal-empty mt-5">
            <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h5">Todavía no hay objetivos</MudText>
            <MudText Typo="Typo.body2">
                Abre un Warframe, arma o mod y pulsa “Añadir a objetivos”.
            </MudText>
            <MudButton Href="/warframes" Variant="Variant.Outlined" Color="Color.Primary">
                Explorar Warframes
            </MudButton>
        </MudPaper>
    }
    else
    {
        @if (analysisLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
            <MudText Typo="Typo.caption" Class="mt-1">Analizando esta página de objetivos...</MudText>
        }
        @if (!string.IsNullOrWhiteSpace(analysisError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                @analysisError
                <MudButton OnClick="LoadAnalysisPageAsync" Size="Size.Small" Variant="Variant.Text">Reintentar</MudButton>
            </MudAlert>
        }
        <MudGrid Class="mt-4">
            @foreach (var goal in VisibleGoals)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="@($"goal-card {(goal.IsCompleted ? "goal-card--complete" : "")}")">
                        <div class="goal-card__header">
                            <span class="goal-type">@GoalTypeLabel(goal.TargetType)</span>
                            <span class="@($"goal-priority goal-priority--{goal.Priority}")">
                                @PriorityLabel(goal.Priority)
                            </span>
                        </div>
                        <MudText Typo="Typo.h5">@goal.DisplayName</MudText>
                        <MudText Typo="Typo.caption">
                            Creado @goal.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy")
                        </MudText>

                        @{
                            analyses.TryGetValue(goal.Id, out var analysis);
                        }
                        @if (analysis is not null)
                        {
                            <div class="goal-progress">
                                <div>
                                    <span>@(goal.TargetType == "relic" ? "PROGRESO DE CANTIDAD" : "PROGRESO DEL SET")</span>
                                    <b>@analysis.ProgressPercent%</b>
                                </div>
                                <MudProgressLinear Value="@analysis.ProgressPercent"
                                                   Color="@(analysis.ProgressPercent == 100 ? Color.Success : Color.Primary)"
                                                   Rounded="true" />
                                @if (analysis.Builds.Count > 0)
                                {
                                    <div class="goal-combined-progress">
                                        <span>PROGRESO GENERAL CON BUILD</span><b>@analysis.OverallProgressPercent%</b>
                                    </div>
                                    <MudProgressLinear Value="@analysis.OverallProgressPercent" Color="Color.Secondary" Rounded="true" />
                                    @foreach (var build in analysis.Builds.Take(2))
                                    {
                                        <span class="goal-build-summary">@build.Name · @build.OwnedMods/@build.TotalMods mods · @build.Percent%</span>
                                    }
                                }
                                @if (analysis.IsOneAway)
                                {
                                    <span class="goal-one-away">A una pieza de completarse</span>
                                }
                                @if (goal.TargetType == "relic")
                                {
                                    <span>@analysis.CurrentQuantity de @analysis.DesiredQuantity copias</span>
                                }
                                else if (analysis.MissingCount > 0)
                                {
                                    <span>@analysis.MissingCount componentes pendientes</span>
                                }
                            </div>

                            @if (analysis.MissingComponents.Count > 0)
                            {
                                <div class="goal-missing">
                                    @foreach (var component in analysis.MissingComponents.Take(4))
                                    {
                                        <span>@WarframeSpanishText.Reward(component)</span>
                                    }
                                </div>
                            }

                            @if (analysis.RelatedRelics.Count > 0)
                            {
                                <div class="goal-relics">
                                    <span class="goal-relics__title">RELIQUIAS ÚTILES</span>
                                    @foreach (var relic in analysis.RelatedRelics)
                                    {
                                        <span class="goal-relic">
                                            <strong>@relic.Name</strong> · @relic.Rarity · <b>Total @relic.OwnedQuantity</b>
                                            <small>I @relic.Intact · E @relic.Exceptional · P @relic.Flawless · R @relic.Radiant</small>
                                            <i>@(relic.Vaulted ? "En bóveda" : "Disponible")</i>
                                        </span>
                                    }
                                </div>
                            }
                        }

                        <div class="goal-card__controls">
                            <MudSelect T="int"
                                       Label="Prioridad"
                                       Value="@goal.Priority"
                                       ValueChanged="@(value => ChangePriorityAsync(goal, value))"
                                       Dense="true">
                                <MudSelectItem T="int" Value="1">Alta</MudSelectItem>
                                <MudSelectItem T="int" Value="2">Media</MudSelectItem>
                                <MudSelectItem T="int" Value="3">Baja</MudSelectItem>
                            </MudSelect>
                            <MudCheckBox T="bool"
                                         Checked="@goal.IsCompleted"
                                         CheckedChanged="@(value => ChangeCompletedAsync(goal, value))"
                                         Label="Completado"
                                         Color="Color.Success" />
                            @if (goal.TargetType == "relic")
                            {
                                <MudNumericField T="int" Value="@goal.DesiredQuantity"
                                                 ValueChanged="@(value => ChangeDesiredAsync(goal, value))"
                                                 Label="Cantidad objetivo" Min="1" Max="9999"
                                                 Variant="Variant.Outlined" />
                            }
                        </div>

                        <div class="goal-card__actions">
                            <div>
                                <MudButton Href="@TargetUrl(goal)" Variant="Variant.Text" Color="Color.Primary">
                                    Abrir objetivo
                                </MudButton>
                                @if (goal.TargetType is "warframe" or "weapon" && analysis?.MissingCount > 0)
                                {
                                    <MudButton Href="@($"/planner/{goal.Id}")"
                                               Variant="Variant.Filled"
                                               Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.Route">
                                        Planificar
                                    </MudButton>
                                }
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Color="Color.Error"
                                           AriaLabel="Eliminar objetivo"
                                           OnClick="@(() => DeleteAsync(goal))" />
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        @if (totalPages > 1)
        {
            <div class="d-flex justify-center mt-5">
                <MudPagination Selected="@currentPage" Count="@totalPages"
                               SelectedChanged="ChangePageAsync" Color="Color.Primary" />
            </div>
        }
    }
</MudContainer>

@code {
    private readonly List<UserGoal> goals = [];
    private IReadOnlyDictionary<int, GoalAnalysis> analyses =
        new Dictionary<int, GoalAnalysis>();
    private string userId = "";
    private bool loading = true;
    private bool analysisLoading;
    private string analysisError = "";
    private string searchTerm = "";
    private string statusFilter = "active";
    private int currentPage = 1;
    private int totalPages = 1;
    private const int PageSize = 6;
    private CancellationTokenSource? analysisCts;
    private int analysisRequest;

    private IReadOnlyList<UserGoal> FilteredGoals
    {
        get
        {
            IEnumerable<UserGoal> query = goals;
            query = statusFilter switch
            {
                "active" => query.Where(x => !x.IsCompleted),
                "completed" => query.Where(x => x.IsCompleted),
                _ => query
            };
            if (!string.IsNullOrWhiteSpace(searchTerm))
                query = query.Where(x => x.DisplayName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            return query.OrderBy(x => x.IsCompleted).ThenBy(x => x.Priority)
                .ThenBy(x => x.DisplayName).ToList();
        }
    }
    private IReadOnlyList<UserGoal> VisibleGoals => FilteredGoals
        .Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

        if (!string.IsNullOrWhiteSpace(userId))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            goals.AddRange(await db.UserGoals.AsNoTracking()
                .Where(x => x.UserId == userId)
                .ToListAsync());
            await LoadAnalysisPageAsync();
        }

        loading = false;
    }

    private async Task LoadAnalysisPageAsync()
    {
        var request = ++analysisRequest;
        analysisCts?.Cancel();
        analysisCts?.Dispose();
        analysisCts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
        analysisLoading = true;
        analysisError = "";
        var filteredCount = FilteredGoals.Count;
        totalPages = Math.Max(1, (int)Math.Ceiling(filteredCount / (double)PageSize));
        currentPage = Math.Clamp(currentPage, 1, totalPages);
        try
        {
            var result = await AnalysisService.AnalyzeAsync(userId, VisibleGoals, analysisCts.Token);
            if (request == analysisRequest) analyses = result;
        }
        catch (OperationCanceledException)
        {
            if (request == analysisRequest)
            {
                analysisError = "El análisis tardó demasiado. La página fue liberada para que puedas reintentar.";
                analyses = new Dictionary<int, GoalAnalysis>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error analizando objetivos: {ex.Message}");
            if (request == analysisRequest)
            {
                analysisError = "No fue posible analizar los objetivos. Reintenta o revisa el despliegue de la base de datos.";
                analyses = new Dictionary<int, GoalAnalysis>();
            }
        }
        finally
        {
            if (request == analysisRequest) analysisLoading = false;
        }
    }

    private async Task RefreshGoalsAsync() { currentPage = 1; await LoadAnalysisPageAsync(); }
    private async Task ChangeStatusFilterAsync(string value) { statusFilter = value; await RefreshGoalsAsync(); }
    private async Task ChangePageAsync(int value) { currentPage = value; await LoadAnalysisPageAsync(); }

    private async Task ChangePriorityAsync(UserGoal goal, int value)
    {
        goal.Priority = value;
        await GoalService.UpdateAsync(userId, goal.Id, goal.Priority, goal.IsCompleted);
        await LoadAnalysisPageAsync();
    }

    private async Task ChangeCompletedAsync(UserGoal goal, bool value)
    {
        goal.IsCompleted = value;
        goal.CompletedUtc = value ? DateTime.UtcNow : null;
        await GoalService.UpdateAsync(userId, goal.Id, goal.Priority, value);
        await LoadAnalysisPageAsync();
    }
    private async Task ChangeDesiredAsync(UserGoal goal, int value)
    {
        goal.DesiredQuantity = Math.Clamp(value, 1, 9999);
        await GoalService.UpdateDesiredQuantityAsync(userId, goal.Id, goal.DesiredQuantity);
        await LoadAnalysisPageAsync();
    }

    private async Task DeleteAsync(UserGoal goal)
    {
        await GoalService.DeleteAsync(userId, goal.Id);
        goals.Remove(goal);
        await LoadAnalysisPageAsync();
    }

    private static string GoalTypeLabel(string type) => type switch
    {
        "warframe" => "WARFRAME",
        "weapon" => "ARMA",
        "mod" => "MOD",
        "relic" => "RELIQUIA",
        _ => type.ToUpperInvariant()
    };

    private static string PriorityLabel(int priority) => priority switch
    {
        1 => "PRIORIDAD ALTA",
        3 => "PRIORIDAD BAJA",
        _ => "PRIORIDAD MEDIA"
    };

    private static string TargetUrl(UserGoal goal)
        => $"/{(goal.TargetType == "weapon" ? "weapons" : goal.TargetType + "s")}/{Uri.EscapeDataString(goal.TargetUnique)}";

    public void Dispose()
    {
        analysisCts?.Cancel();
        analysisCts?.Dispose();
    }
}
