@inherits LayoutComponentBase
@inject NavigationManager Nav

<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />
<audio id="ambient-soundtrack" src="/audio/pulso-de-neon.mp3" loop preload="metadata"></audio>

<MudLayout Class="orokin-shell">
    <MudAppBar Class="orokin-appbar" Elevation="0" Fixed="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" OnClick="ToggleDrawer"
                       Color="Color.Inherit" AriaLabel="Abrir navegación" />
        <a class="brand" href="/" aria-label="Registro Warframe, inicio">
            <span class="brand-mark" aria-hidden="true">◈</span>
            <span>WARFRAME <small>REGISTRO</small></span>
        </a>
        <MudSpacer />
        <a href="/search" class="command-trigger" aria-label="Abrir búsqueda universal">
            <MudIcon Icon="@Icons.Material.Filled.Search" /><span>Buscar</span><kbd>Ctrl K</kbd>
        </a>
        <button type="button" class="energy-toggle" onclick="warframeTracker.toggleEnergyMode()"
                aria-label="Alternar movimiento reducido" title="Movimiento reducido">
            <MudIcon Icon="@Icons.Material.Filled.MotionPhotosOff" />
        </button>
        <button id="ambient-audio-toggle" type="button" class="energy-toggle audio-toggle"
                onclick="warframeTracker.audio.toggleAmbient()"
                aria-label="Activar música ambient techno" aria-pressed="false"
                title="Música ambient techno">
            <MudIcon Icon="@Icons.Material.Filled.GraphicEq" />
        </button>
        <label class="ambient-volume-control" title="Volumen de música">
            <MudIcon Icon="@Icons.Material.Filled.VolumeDown" />
            <input id="ambient-volume" type="range" min="0" max="100" step="1" value="35"
                   aria-label="Volumen de música ambiental"
                   oninput="warframeTracker.audio.setAmbientVolume(this.value)" />
            <span id="ambient-volume-value">35%</span>
        </label>
        <button id="interface-audio-toggle" type="button" class="energy-toggle audio-toggle"
                onclick="warframeTracker.audio.toggleEffects()"
                aria-label="Activar sonidos de interfaz" aria-pressed="false"
                title="Sonidos de interfaz">
            <MudIcon Icon="@Icons.Material.Filled.VolumeUp" />
        </button>
        <AuthorizeView>
            <Authorized>
                <span class="tenno-id">@context.User.Identity?.Name</span>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="Logout"
                           StartIcon="@Icons.Material.Filled.Logout">Salir</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/auth/login">Ingresar</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/auth/register">Crear cuenta</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Class="orokin-drawer" Elevation="0"
               Variant="DrawerVariant.Temporary" Anchor="Anchor.Left">
        <div class="drawer-title">NAVEGACIÓN</div>
        <div @onclick="CloseDrawer">
            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">Centro de mando</MudNavLink>
                <MudNavLink Href="/warframes" Icon="@Icons.Material.Filled.Face">Warframes</MudNavLink>
                <MudNavLink Href="/weapons" Icon="@Icons.Material.Filled.GpsFixed">Armas</MudNavLink>
                <MudNavLink Href="/mods" Icon="@Icons.Material.Filled.AutoFixHigh">Mods</MudNavLink>
                <MudNavLink Href="/resources" Icon="@Icons.Material.Filled.Science">Recursos</MudNavLink>
                <MudNavLink Href="/relics" Icon="@Icons.Material.Filled.Diamond">Reliquias</MudNavLink>
                <MudNavLink Href="/worldstate" Icon="@Icons.Material.Filled.Public">Worldstate</MudNavLink>
                <MudNavLink Href="/compare" Icon="@Icons.Material.Filled.CompareArrows">Comparador</MudNavLink>
                <AuthorizeView>
                    <Authorized>
                        <MudNavLink Href="/goals" Icon="@Icons.Material.Filled.TrackChanges">Objetivos</MudNavLink>
                        <MudNavLink Href="/buildable" Icon="@Icons.Material.Filled.Inventory2">Construibles</MudNavLink>
                        <MudNavLink Href="/inventory-tools" Icon="@Icons.Material.Filled.SyncAlt">Transferir inventario</MudNavLink>
                        <MudNavLink Href="/relic-sync" Icon="@Icons.Material.Filled.CloudSync">Sincronizar reliquias</MudNavLink>
                        <MudNavLink Href="/inventory-manager" Icon="@Icons.Material.Filled.EditNote">Editor e historial</MudNavLink>
                        <MudNavLink Href="/builds" Icon="@Icons.Material.Filled.Build">Builds</MudNavLink>
                    </Authorized>
                </AuthorizeView>
            </MudNavMenu>
        </div>
        <AuthorizeView>
            <NotAuthorized>
                <div class="drawer-hint">Explora el catálogo libremente. Inicia sesión para registrar tu inventario.</div>
            </NotAuthorized>
        </AuthorizeView>
    </MudDrawer>

    <MudMainContent Class="orokin-main">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void CloseDrawer() => _drawerOpen = false;
    private void Logout() => Nav.NavigateTo("/auth/logout", forceLoad: true);

    private readonly MudTheme _theme = new()
    {
        Palette = new Palette
        {
            Primary = "#77e7ff",
            Secondary = "#d8b86a",
            Background = "#050b12",
            Surface = "#0b1620",
            AppbarBackground = "#071018",
            DrawerBackground = "#071018",
            TextPrimary = "#eaf9ff",
            TextSecondary = "#9cb5c0",
            Success = "#5de0aa",
            Warning = "#e4c46e",
            Error = "#ff6f78"
        },
        Typography = new Typography
        {
            Default = new Default { FontFamily = ["Rajdhani", "Segoe UI", "sans-serif"] },
            H4 = new H4 { FontWeight = 600, LetterSpacing = ".08em" },
            H5 = new H5 { FontWeight = 600, LetterSpacing = ".06em" },
            H6 = new H6 { FontWeight = 600, LetterSpacing = ".05em" }
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "2px" }
    };
}
